# Production site URL — used for canonical URLs, hreflang, sitemap and Open Graph.
SITE_URL="https://assinkschipholt.nl"

# Google Analytics 4 measurement ID. Alleen actief wanneer PUBLIC_SITE_LIVE="true"
# staat, zodat preview-/ontwikkelverkeer niet meetelt.
PUBLIC_GA_ID="G-XXXXXXXXXX"

# ── Automatische blogconceptgenerator (src/pages/api/cron/blog-generator.ts) ─
# Draait wekelijks via Vercel Cron (zie vercel.json). Schrijft alleen concepten
# (gepubliceerd: false) — niets komt live zonder handmatige goedkeuring in
# Keystatic.
ANTHROPIC_API_KEY="sk-ant-..."
# Fine-grained GitHub personal access token, alleen voor deze repo, met
# Contents: Read and write. Los van Keystatic's eigen GitHub-app/inlog.
GITHUB_TOKEN="github_pat_..."
# Willekeurige lange string (bv. `openssl rand -hex 32`). Vercel stuurt deze
# automatisch mee als "Authorization: Bearer $CRON_SECRET" bij het aanroepen
# van de cron-route, zodat die niet door iemand anders te triggeren is.
CRON_SECRET="..."
# Waar de meldingsmail bij een nieuw conceptartikel naartoe gaat. Standaard
# (zonder deze variabele) gaat die naar kelvin@twentekracht.nl en
# l.baas@baas-metaal.nl. Meerdere adressen: kommagescheiden.
BLOG_NOTIFY_TO="kelvin@twentekracht.nl, l.baas@baas-metaal.nl"

# ── Formulieren (verzending via Resend) ─────────────────────────────────────
# De formulieren versturen via SMTP. Zonder deze variabelen krijgt de bezoeker
# een nette foutmelding met telefoonnummer, in plaats van dat een aanvraag
# stil verdwijnt. MAIL_FROM moet op het in Resend geverifieerde subdomein liggen.
SMTP_HOST="smtp.resend.com"
SMTP_PORT="587"
SMTP_USER="resend"
SMTP_PASS="re_..."
MAIL_TO="info@assinkschipholt.nl"
MAIL_FROM="website@send.assinkschipholt.nl"
