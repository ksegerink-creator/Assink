# Production site URL — used for canonical URLs, hreflang, sitemap and Open Graph.
SITE_URL="https://assinkschipholt.nl"

# ── Formulieren ────────────────────────────────────────────────────────────
# De drie formulieren versturen via de eigen mailserver. Zonder deze
# variabelen krijgt de bezoeker een nette foutmelding met telefoonnummer,
# in plaats van dat een aanvraag stil verdwijnt.
SMTP_HOST="smtp.jullieprovider.nl"
SMTP_PORT="587"
SMTP_USER="website@assinkschipholt.nl"
SMTP_PASS=""
MAIL_TO="info@assinkschipholt.nl"
MAIL_FROM="website@assinkschipholt.nl"
