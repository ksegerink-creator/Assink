# Production site URL — used for canonical URLs, hreflang, sitemap and Open Graph.
SITE_URL="https://assinkschipholt.nl"

# Google Analytics 4 measurement ID. Alleen actief wanneer PUBLIC_SITE_LIVE="true"
# staat, zodat preview-/ontwikkelverkeer niet meetelt.
PUBLIC_GA_ID="G-XXXXXXXXXX"

# ── Formulieren (verzending via Resend) ─────────────────────────────────────
# De formulieren versturen via SMTP. Zonder deze variabelen krijgt de bezoeker
# een nette foutmelding met telefoonnummer, in plaats van dat een aanvraag
# stil verdwijnt. MAIL_FROM moet op het in Resend geverifieerde subdomein liggen.
SMTP_HOST="smtp.resend.com"
SMTP_PORT="587"
SMTP_USER="resend"
SMTP_PASS="re_..."
MAIL_TO="info@assinkschipholt.nl"
MAIL_FROM="website@send.assinkschipholt.nl"
