---
import { t } from "@data/i18n";
import { localizePath, toLocale } from "@utils/paths";

/**
 * Vaste onderdelen van elk formulier: het honeypot-veld, het tijdstempelveld,
 * de verplichte AVG-checkbox en het vak voor de statusmelding.
 *
 * Het honeypot-veld is voor bezoekers verborgen maar niet met `display:none` —
 * sommige bots vullen juist alleen zichtbare velden niet in. We halen het uit
 * beeld en uit de tabvolgorde, en zetten aria-hidden zodat schermlezers het
 * overslaan.
 */
interface Props {
  /** Welk formulier: bepaalt waar we bij een fout naartoe terugsturen. */
  soort: "hero" | "contact" | "offerte";
}
const { soort } = Astro.props;
const locale = toLocale(Astro.currentLocale);
// Privacyverklaring in de taal van de pagina.
const privacy = localizePath("privacy", locale);
/**
 * Op de eigen server (Apache-build) kan het formulier een Cloudflare
 * Turnstile-controle vragen. Of dat zo is en met welke site-sleutel, staat in
 * private/config.php op de server; het script hieronder vraagt dat op bij
 * GET /api/aanvraag. In de Vercel-build komt dit vak er niet in.
 */
const captcha = process.env.BUILD_TARGET === "apache";
---
<input type="hidden" name="soort" value={soort} />
<input type="hidden" name="taal" value={locale} />
<input type="hidden" name="ts" value="" data-ts />

<div class="hp" aria-hidden="true">
  <label>Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
</div>

<label class="consent">
  <input type="checkbox" name="akkoord" required />
  <span>
    {t(locale, "consentPre")} <a href={privacy} target="_blank" rel="noopener">{t(locale, "consentLink")}</a>{t(locale, "consentPost") ? ` ${t(locale, "consentPost")}` : ""}.
  </span>
</label>

{captcha && <div class="fcaptcha" data-captcha hidden></div>}

<p class="fstatus" role="status" aria-live="polite" data-status hidden></p>

<style>
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .consent {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: .6rem;
    align-items: start;
    font-family: var(--f-body) !important;
    font-size: 14px !important;
    letter-spacing: 0 !important;
    text-transform: none !important;
    color: var(--ink-2) !important;
    line-height: 1.5;
  }
  .consent input {
    appearance: none;
    width: 1.5rem; height: 1.5rem;
    margin: 0;
    border: 1.5px solid var(--steel);
    background: transparent;
    display: grid; place-content: center;
    cursor: pointer;
    flex: none;
  }
  .consent input:checked { background: var(--blue); border-color: var(--blue); }
  .consent input:checked::after {
    content: "";
    width: .34rem; height: .68rem;
    border: solid #fff; border-width: 0 2px 2px 0;
    transform: rotate(45deg) translate(-1px, -1px);
  }
  .consent input:focus-visible { outline: 2px solid var(--blue); outline-offset: 2px; }
  .consent a { color: var(--blue); text-decoration: underline; text-underline-offset: 2px; }

  .fcaptcha { min-height: 65px; }

  .fstatus {
    font-family: var(--f-mono);
    font-size: 13px;
    line-height: 1.5;
    padding: .6rem .8rem;
    border-left: 2px solid var(--blue);
    background: var(--sky-bg);
    color: var(--ink);
  }
  .fstatus[data-fout] { border-left-color: #B4472A; background: color-mix(in srgb, #B4472A 8%, transparent); }
  /*
   * :global nodig — .fdone wordt door het script hieronder met
   * document.createElement() aangemaakt. Astro's scoped CSS werkt via een
   * data-astro-cid-…-attribuut dat alleen op elementen komt die in deze
   * template staan; dynamisch aangemaakte elementen krijgen dat attribuut
   * niet en missen anders elke scoped stijl.
   */
  :global(.fdone) {
    font-family: var(--f-body);
    font-size: 15px;
    line-height: 1.5;
    color: var(--ink);
    border-left: 2px solid var(--blue);
    background: var(--sky-bg);
    padding: 1rem 1.1rem;
  }
  :global(.fdone strong) {
    display: block;
    font-family: var(--f-disp);
    font-weight: 600;
    font-size: 1.2rem;
    color: var(--blue);
    margin-bottom: .35rem;
  }
</style>

<script>
  /**
   * Progressieve verbetering. Zonder JavaScript post het formulier gewoon naar
   * /api/aanvraag en stuurt de server door naar de bedanktpagina. Met
   * JavaScript versturen we via fetch en tonen we de melding op de pagina, zodat
   * de bezoeker zijn plek niet verliest.
   */
  const lang = document.documentElement.lang;
  const TEKST = {
    sending: lang.startsWith("de") ? "Wird gesendet…" : lang.startsWith("en") ? "Sending…" : "Versturen…",
    check: lang.startsWith("de")
      ? "Sicherheitsprüfung läuft…"
      : lang.startsWith("en")
        ? "Running security check…"
        : "Beveiligingscontrole loopt…",
  };

  /**
   * Cloudflare Turnstile, alleen op de eigen server en alleen als die daar is
   * ingesteld. Pas geladen bij de eerste interactie met een formulier, zodat
   * een bezoeker die niets invult er niets van merkt (en de homepage niet
   * trager wordt). Eén belofte voor de hele pagina.
   */
  type Turnstile = {
    render: (el: HTMLElement, opts: Record<string, unknown>) => string;
    getResponse: (id: string) => string | undefined;
    reset: (id: string) => void;
  };
  type TurnstileKlaar = { api: Turnstile; sitekey: string } | null;
  let turnstileKlaar: Promise<TurnstileKlaar> | undefined;
  function laadTurnstile(): Promise<TurnstileKlaar> {
    turnstileKlaar ??= fetch("/api/aanvraag", { headers: { accept: "application/json" } })
      .then((r) => (r.ok ? r.json() : null))
      .then((cfg) => {
        if (!cfg?.captcha) return null;
        return new Promise<TurnstileKlaar>((resolve) => {
          const s = document.createElement("script");
          s.src = "https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit";
          s.async = true;
          s.onload = () => {
            const api = (window as unknown as { turnstile?: Turnstile }).turnstile;
            resolve(api ? { api, sitekey: String(cfg.captcha) } : null);
          };
          s.onerror = () => resolve(null);
          document.head.append(s);
        });
      })
      .catch(() => null);
    return turnstileKlaar;
  }

  document.querySelectorAll<HTMLFormElement>('form[action="/api/aanvraag"]').forEach((form) => {
    const ts = form.querySelector<HTMLInputElement>("[data-ts]");
    if (ts) ts.value = String(Date.now());

    const status = form.querySelector<HTMLElement>("[data-status]");
    const knop = form.querySelector<HTMLButtonElement>('button[type="submit"]');

    // Turnstile-widget: id zodra gerenderd, en een belofte die de token oplevert.
    const vak = form.querySelector<HTMLElement>("[data-captcha]");
    let widget: { api: Turnstile; id: string } | null = null;
    let widgetKlaar: Promise<void> | undefined;
    const startCaptcha = () => {
      const el = vak;
      if (!el) return Promise.resolve();
      widgetKlaar ??= laadTurnstile().then((t) => {
        if (!t) return;
        el.hidden = false;
        const id = t.api.render(el, { sitekey: t.sitekey, language: lang.slice(0, 2) || "nl" });
        widget = { api: t.api, id };
      });
      return widgetKlaar;
    };
    if (vak) {
      form.addEventListener("focusin", startCaptcha, { once: true });
      form.addEventListener("pointerdown", startCaptcha, { once: true });
    }
    /** Wacht tot Turnstile een token heeft, maximaal ±15 seconden. */
    const wachtOpToken = async () => {
      await startCaptcha();
      for (let i = 0; widget && !widget.api.getResponse(widget.id) && i < 60; i++) {
        await new Promise((r) => setTimeout(r, 250));
      }
    };

    form.addEventListener("submit", async (e) => {
      // Laat de browser zelf de verplichte velden afdwingen.
      if (!form.checkValidity()) return;
      e.preventDefault();

      if (status) {
        status.hidden = false;
        status.removeAttribute("data-fout");
        status.textContent = TEKST.sending;
      }
      if (knop) knop.disabled = true;

      try {
        if (vak) {
          if (status) status.textContent = TEKST.check;
          await wachtOpToken();
          if (status) status.textContent = TEKST.sending;
        }
        const res = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { accept: "application/json" },
        });
        const data = await res.json().catch(() => ({ ok: false, bericht: "" }));

        if (res.ok && data.ok) {
          // Inhoud van het formulier vervangen door de bevestiging — niet het
          // <form>-element zelf. Dat element draagt op sommige pagina's de
          // kaartopmaak (achtergrond, rand, schaduw, padding), bijvoorbeeld
          // .hform in de hero; die opmaak moet blijven staan.
          const klaar = document.createElement("div");
          klaar.className = "fdone";
          klaar.setAttribute("role", "status");
          const veilig = document.createElement("span");
          veilig.textContent = data.bericht ?? "";
          klaar.innerHTML = "<strong>✓</strong>";
          klaar.append(veilig);
          form.replaceChildren(klaar);
          form.scrollIntoView({ block: "center", behavior: "smooth" });
          return;
        }

        if (status) {
          status.setAttribute("data-fout", "");
          status.textContent = data.bericht || "Het verzenden lukte niet.";
        }
        // Een Turnstile-token is maar één keer bruikbaar.
        if (widget) widget.api.reset(widget.id);
      } catch {
        if (status) {
          status.setAttribute("data-fout", "");
          status.textContent = "Geen verbinding. Probeer het opnieuw of bel ons.";
        }
      } finally {
        if (knop) knop.disabled = false;
      }
    });
  });
</script>
