---
import { SOCIAL } from "@data/site";
import SocialIcon from "./SocialIcon.astro";

/**
 * Social-iconen (LinkedIn / Facebook / Instagram).
 * URL's komen uit het CMS (Bedrijfsgegevens); een leeg veld verbergt het icoon.
 */
interface Props { class?: string }
const { class: cls = "" } = Astro.props;

const links = [
  { name: "LinkedIn", href: SOCIAL.linkedin },
  { name: "Facebook", href: SOCIAL.facebook },
  { name: "Instagram", href: SOCIAL.instagram },
].filter((s) => s.href);
---
{
  links.length > 0 && (
    <div class={`soc ${cls}`}>
      {links.map((s) => (
        <a class="soc__a" href={s.href} aria-label={s.name} title={s.name} target="_blank" rel="noopener noreferrer">
          <SocialIcon name={s.name} size={18} />
        </a>
      ))}
    </div>
  )
}
<style>
  .soc { display: inline-flex; align-items: center; gap: 2px; }
  .soc__a {
    display: inline-flex; align-items: center; justify-content: center;
    width: 34px; height: 34px; color: var(--ink-2);
    transition: color .15s var(--ease), background .15s var(--ease);
  }
  .soc__a:hover { color: var(--blue); }
</style>
