---
import { t } from "@data/i18n";
import { SITE } from "@data/site";
import { localizePath, toLocale } from "@utils/paths";

/**
 * Officieel Assink & Schipholt-logo (uit 01_Brand\Logo's).
 * Header: horizontale variant met payoff · Footer: gestapelde witte variant.
 */
interface Props { variant?: "default" | "footer" }
const { variant = "default" } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const home = localizePath("", locale);
---
<a class={`logo logo--${variant}`} href={home} aria-label={`${SITE.name} — home`}>
  {variant === "footer" ? (
    <img src="/logos/as-logo-footer-wit.png" alt={`${SITE.name} — ${t(locale, "tagline")}`} width="150" height="126" loading="lazy" />
  ) : (
    <img src="/logos/as-logo-header.png" alt={`${SITE.name} — ${t(locale, "tagline")}`} width="335" height="85" />
  )}
</a>
<style>
  /* flex-shrink: 0 — anders drukt het menu het logo rond 1280 px samen tot
     een smalle streep (de hoogte ligt vast, de breedte gaf mee). */
  .logo { display: inline-flex; align-items: center; flex-shrink: 0; }
  .logo--default img { height: 44px; width: auto; }
  .logo--footer img { height: 96px; width: auto; }
  @media (max-width: 680px) { .logo--default img { height: 38px; } }
  /* Smalle telefoons (360–400 px): anders past de offerteknop er niet naast. */
  @media (max-width: 400px) { .logo--default img { height: 30px; } }
</style>
