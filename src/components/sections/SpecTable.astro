---
import { t } from "@data/i18n";
import type { Locale } from "@data/site";

/**
 * Specificaties van een dienst of machine. Gebruikt door de dienstpagina's en
 * de overzichtspagina's.
 *
 * Stond eerder als tabel rechts naast een kop, met links een grote lege
 * kolom en waarden in monospace. Nu: kop erboven en de regels over twee
 * kolommen, zodat het blok half zo lang is; waarden in het gewone lettertype,
 * omdat het vaak halve zinnen zijn ("ruimer dan bij staal — aluminium rekt
 * minder"). Een definitielijst, want het zijn label-waardeparen.
 */
interface Props {
  specs?: { label: string; value: string }[];
  locale: Locale;
  kop?: string;
}
const { specs = [], locale, kop } = Astro.props;
---
{specs.length > 0 && (
  <section class="sec tight">
    <div class="wrap">
      <div class="sspec__head rv">
        <h2>{kop || t(locale, "specsHead")}</h2>
        <span class="mono">{t(locale, "specsCaption")}</span>
      </div>
      <dl class="sspec rv">
        {specs.map((r) => (
          <div class="sspec__row">
            <dt>{r.label}</dt>
            <dd>{r.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
)}

<style>
  .sspec__head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px 20px; border-top: 1px solid var(--ink); padding-top: 14px; margin-bottom: clamp(16px, 2vw, 24px); }
  .sspec__head h2 { font-size: clamp(22px, 2.4vw, 32px); }
  .sspec__head .mono { margin-left: auto; font-size: 11.5px; letter-spacing: .08em; text-transform: uppercase; color: var(--steel); }
  .sspec { margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: clamp(24px, 4vw, 64px); }
  .sspec__row {
    display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); gap: 16px;
    padding-block: 13px; border-bottom: 1px solid var(--line);
  }
  .sspec dt { color: var(--ink-2); font-size: 15px; }
  .sspec dd { margin: 0; color: var(--ink); font-size: 15px; font-weight: 500; font-variant-numeric: tabular-nums; overflow-wrap: break-word; hyphens: auto; }
  @media (max-width: 860px) { .sspec { grid-template-columns: 1fr; } }
  @media (max-width: 420px) { .sspec__row { grid-template-columns: 1fr; gap: 2px; } .sspec__head .mono { margin-left: 0; } }
</style>
