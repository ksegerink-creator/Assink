---
import IndustrialImage from "@components/media/IndustrialImage.astro";
import { t } from "@data/i18n";
import type { Locale } from "@data/site";
import type { ImageMetadata } from "astro";

/**
 * De route die een werkstuk aflegt, als genummerde stappen. Gebruikt door de
 * dienstpagina's en de overzichtspagina's.
 *
 * Stond eerder als verticale lijst naast een kop — dezelfde vorm als de
 * specificaties en de aanleverlijst eronder, waardoor de pagina één
 * doorlopende kolom tekst werd. Nu een horizontale stappenrij op een
 * lichtgekleurde band: op desktop in één oogopslag te volgen, en het breekt
 * het ritme van de pagina.
 */
interface Props {
  process?: { step: string; desc: string }[];
  locale: Locale;
  /** Foto bij de stappen; komt als brede strook onder de rij. */
  image?: ImageMetadata;
  imageAlt?: string;
}
const { process = [], locale, image, imageAlt } = Astro.props;
const [kop1, kop2] = t(locale, "drawingToDelivery").split("|");
---
{process.length > 0 && (
  <section class="sec tight sproc">
    <div class="wrap">
      <h2 class="sproc__h rv">{`${kop1} ${kop2}`}</h2>
      <ol class="sproc__list" style={`--n: ${Math.min(process.length, 5)}`}>
        {process.map((p, i) => (
          <li class="rv">
            <span class="sproc__n" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            <h3>{p.step}</h3>
            <p>{p.desc}</p>
          </li>
        ))}
      </ol>
      {image && (
        <figure class="sproc__img rv">
          <IndustrialImage src={image} alt={imageAlt ?? ""} ratio="21/9" />
        </figure>
      )}
    </div>
  </section>
)}

<style>
  .sproc { background: var(--surface-2); }
  .sproc__h { font-size: clamp(24px, 2.8vw, 38px); margin-bottom: clamp(22px, 3vw, 36px); }
  .sproc__list {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); gap: clamp(14px, 1.6vw, 22px);
  }
  .sproc__list li {
    position: relative; background: var(--surface); border-top: 3px solid var(--blue);
    padding: clamp(18px, 2vw, 26px);
  }
  .sproc__n {
    display: block; font-family: var(--f-disp); font-weight: 600; font-size: clamp(30px, 3vw, 42px); line-height: 1;
    color: var(--blue); font-variant-numeric: tabular-nums;
  }
  .sproc__list h3 { font-size: clamp(17px, 1.6vw, 20px); margin-top: 14px; }
  .sproc__list p { color: var(--ink-2); font-size: 15px; line-height: 1.6; margin-top: 8px; }
  .sproc__img { margin: clamp(18px, 2vw, 26px) 0 0; }
  /* Bij vijf stappen worden de kolommen op een laptop te smal: twee rijen. */
  @media (max-width: 1100px) { .sproc__list { grid-template-columns: repeat(min(var(--n), 3), minmax(0, 1fr)); } }
  @media (max-width: 780px) {
    .sproc__list { grid-template-columns: 1fr; gap: 10px; }
    .sproc__list li { display: grid; grid-template-columns: 48px 1fr; column-gap: 12px; border-top: 0; border-left: 3px solid var(--blue); padding: 16px; }
    .sproc__n { font-size: 26px; grid-row: span 2; }
    .sproc__list h3 { margin-top: 0; }
    .sproc__list p { margin-top: 4px; }
  }
</style>
