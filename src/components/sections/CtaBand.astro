---
import { t } from "@data/i18n";
import { CONTACT } from "@data/site";
import { localizePath, toLocale } from "@utils/paths";
import { readPage } from "@utils/content";

const locale = toLocale(Astro.currentLocale);
const nav = (slug: string) => localizePath(slug, locale);

// Titel en subtekst komen per taal uit het CMS (algemeen), met terugval op NL.
const alg = await readPage("algemeen", locale);
const h = { l1: alg.ctaTitelRegel1, l2: alg.ctaTitelRegel2 };
const sub = alg.ctaSubtekst;
---
<section class="sec band">
  <div class="wrap cta rv">
    <div>
      <h2>{h.l1}<br /><span class="alt">{h.l2}</span></h2>
      <p class="cta__sub">{sub} · <a href={CONTACT.telHref}>{CONTACT.tel}</a> · <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></p>
    </div>
    <div class="cta__acts">
      <a class="btn" href={nav("offerte")}>{t(locale, "quote")}</a>
      <a class="btn ghost" href={nav("contact")}>{t(locale, "contact")}</a>
    </div>
  </div>
</section>
<style>
  .cta { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 28px; }
  .cta h2 { font-size: clamp(26px, 3.6vw, 46px); color: #fff; }
  .cta .alt { color: var(--sky); }
  .cta__sub { margin-top: 14px; font-size: 14.5px; color: #A9BFD6; }
  .cta__sub a { color: #DCE8F3; text-decoration: underline; text-underline-offset: 3px; }
  .cta__sub a:hover { color: #fff; }
  .cta__acts { display: flex; gap: 12px; flex-wrap: wrap; }
</style>
