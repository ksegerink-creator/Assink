---
/**
 * Kenmerken: drie à vier kernpunten als kaarten met een icoon, direct onder de
 * hero. Naast de kerncijfers (losse getallen) voor pagina's waar een korte
 * belofte meer zegt dan een getal — zoals "Gecertificeerd laswerk:
 * kwaliteitsborging volgens ISO 3834-2" op de defensiepagina.
 *
 * De iconen staan hier inline als SVG (lijnstijl, 24×24), zodat er geen
 * icoonbibliotheek bij hoeft en ze de tekstkleur volgen.
 */
interface Props {
  items?: { icoon: string; titel: string; tekst: string }[];
}
const { items = [] } = Astro.props;

const ICONEN: Record<string, string> = {
  gereedschap:
    '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>',
  schild:
    '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>',
  gewicht:
    '<path d="M2 20h20"/><path d="M4 20V9l5 3V9l5 3V9l5 3v8"/><path d="M8 16h1M12 16h1M16 16h1"/>',
  checklist:
    '<rect x="5" y="4" width="14" height="18" rx="2"/><path d="M9 2h6v4H9z"/><path d="m9 14 2 2 4-4"/>',
  laser:
    '<path d="M12 2v6"/><path d="M8 8h8l-2 5h-4z"/><path d="M12 13v3"/><path d="M4 21h16"/><path d="m9 18-1 3M15 18l1 3"/>',
  las:
    '<path d="M3 21 14 10"/><path d="m14 10 3-3 4 4-3 3z"/><path d="M5 12l2 2M8 9l2 2M2 15l2 2"/>',
};
---
{items.length > 0 && (
  <section class="sec tight km">
    <div class="wrap">
      <ul class="km__rij" data-n={Math.min(items.length, 4)}>
        {items.map((it) => (
          <li class="km__kaart rv">
            <svg class="km__icoon" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor"
              stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
              set:html={ICONEN[it.icoon] ?? ICONEN.gereedschap} />
            <h3>{it.titel}</h3>
            <p>{it.tekst}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .km__rij { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .km__rij[data-n="2"] { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .km__rij[data-n="3"] { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .km__kaart { border: 1px solid var(--line); background: var(--surface); padding: 20px 22px 22px; }
  .km__icoon { color: var(--blue); display: block; }
  .km__kaart h3 { font-size: clamp(17px, 1.6vw, 20px); margin-top: 14px; }
  .km__kaart p { color: var(--ink-2); font-size: 15px; line-height: 1.55; margin-top: 6px; }
  @media (max-width: 1000px) { .km__rij, .km__rij[data-n="3"] { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 520px) { .km__rij, .km__rij[data-n] { grid-template-columns: 1fr; gap: 10px; } }
</style>
