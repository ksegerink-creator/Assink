---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { imageFor } from "@data/images";

/**
 * Herbruikbaar fotografiecomponent.
 *
 * Met beeld  → geoptimaliseerde <Image> (Astro image optimisation).
 * Zonder beeld → vormgegeven Assink & Schipholt-placeholder: bleekblauw vlak,
 * fijne navy rand, snijlijnen, ratio-aanduiding en een subtiel intern
 * ontwikkellabel dat exact beschrijft welke foto nodig is.
 */
interface Props {
  /** Direct geïmporteerde afbeelding (heeft voorrang op imageKey). */
  src?: ImageMetadata;
  /** Sleutel in de centrale beeldregistratie (src/data/images.ts). */
  imageKey?: string;
  alt?: string;
  caption?: string;
  /** Beeldverhouding, bv. "16/10", "4/3", "21/9", "1/1", "3/4". */
  ratio?: string;
  /** object-position bij echt beeld, bv. "center" of "60% 40%". */
  position?: string;
  /** Ontwikkellabel: "Foto benodigd — …". */
  placeholder?: string;
  credit?: string;
  /** Eager laden (hero's boven de vouw). */
  priority?: boolean;
  /** Kleine technische annotatie (bv. procesnaam). */
  annotation?: string;
  /** Optioneel beeldnummer, bv. "IMG-03.2". */
  number?: string;
  class?: string;
}

const {
  src,
  imageKey,
  alt,
  caption,
  ratio = "4/3",
  position = "center",
  placeholder = "Foto benodigd",
  credit,
  priority = false,
  annotation,
  number,
  class: cls = "",
} = Astro.props;

const resolved: ImageMetadata | undefined = src ?? imageFor(imageKey);
const ratioCss = ratio.replace(":", "/");
const ratioLabel = ratioCss.replace("/", ":");
const altText = alt ?? placeholder;
---

<figure class={`ii ${cls}`} style={`aspect-ratio:${ratioCss};`}>
  {
    resolved ? (
      <>
        <Image
          src={resolved}
          alt={altText}
          widths={[480, 800, 1200, 1800]}
          sizes="(max-width: 860px) 100vw, 60vw"
          loading={priority ? "eager" : "lazy"}
          class="ii__img"
          style={`object-position:${position};`}
        />
        {annotation && <span class="ii__anno">{annotation}</span>}
        {number && <span class="ii__num">{number}</span>}
      </>
    ) : (
      <div class="ii__ph" role="img" aria-label={placeholder}>
        <span class="ii__crop" aria-hidden="true" />
        <span class="ii__tick t1" /><span class="ii__tick t2" />
        <span class="ii__tick t3" /><span class="ii__tick t4" />
        <span class="ii__ratio">{ratioLabel}</span>
        {number && <span class="ii__num">{number}</span>}
        <span class="ii__label">{placeholder}</span>
        {annotation && <span class="ii__anno ii__anno--ph">{annotation}</span>}
      </div>
    )
  }
  {
    (caption || credit) && (
      <figcaption class="ii__cap">
        {caption && <span>{caption}</span>}
        {credit && <span class="ii__credit">© {credit}</span>}
      </figcaption>
    )
  }
</figure>

<style>
  .ii { position: relative; margin: 0; overflow: hidden; background: var(--plate); }
  .ii :global(.ii__img) { width: 100%; height: 100%; object-fit: cover; display: block; }

  /* placeholder ------------------------------------------------ */
  .ii__ph { position: absolute; inset: 0; border: 1px solid var(--navy); }
  .ii__crop {
    position: absolute; inset: 0; opacity: .55;
    background:
      linear-gradient(color-mix(in srgb, var(--navy) 12%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--navy) 12%, transparent) 1px, transparent 1px);
    background-size: 36px 36px; background-position: center;
  }
  .ii__crop::before, .ii__crop::after {
    content: ""; position: absolute; background: color-mix(in srgb, var(--navy) 22%, transparent);
  }
  .ii__crop::before { left: 50%; top: 0; bottom: 0; width: 1px; }
  .ii__crop::after { top: 50%; left: 0; right: 0; height: 1px; }

  .ii__tick { position: absolute; background: var(--blue-2); z-index: 2; }
  .t1 { top: 12px; left: 12px; width: 20px; height: 1.5px; }
  .t2 { top: 12px; left: 12px; width: 1.5px; height: 20px; }
  .t3 { bottom: 12px; right: 12px; width: 20px; height: 1.5px; }
  .t4 { bottom: 12px; right: 12px; width: 1.5px; height: 20px; }

  .ii__ratio {
    position: absolute; top: 12px; right: 12px; z-index: 2;
    font-family: var(--f-mono); font-size: 10px; letter-spacing: .08em; color: var(--steel);
  }
  .ii__label {
    position: absolute; left: 14px; bottom: 14px; right: 14px; z-index: 2;
    font-family: var(--f-mono); font-size: 10.5px; letter-spacing: .07em; text-transform: uppercase;
    color: var(--ink-2); line-height: 1.5; max-width: 34em;
  }
  .ii__label::before { content: "◉ "; color: var(--blue); }

  /* annotaties / nummer ---------------------------------------- */
  .ii__anno {
    position: absolute; left: 14px; top: 12px; z-index: 3;
    font-family: var(--f-mono); font-size: 10px; letter-spacing: .09em; text-transform: uppercase;
    color: var(--navy); background: color-mix(in srgb, var(--bg) 85%, transparent);
    border-left: 2px solid var(--blue-2); padding: 4px 8px;
  }
  .ii__anno--ph { background: transparent; }
  .ii__num {
    position: absolute; right: 12px; bottom: 12px; z-index: 3;
    font-family: var(--f-mono); font-size: 10px; letter-spacing: .08em; color: var(--steel);
    font-variant-numeric: tabular-nums;
  }
  .ii__ph .ii__num { bottom: auto; top: 30px; }

  .ii__cap {
    position: absolute; inset: auto 0 0 0; display: flex; justify-content: space-between; gap: 12px;
    padding: 10px 14px; background: linear-gradient(transparent, color-mix(in srgb, var(--navy) 55%, transparent));
    color: #fff; font-family: var(--f-mono); font-size: 11px; letter-spacing: .06em; text-transform: uppercase;
  }
  .ii__credit { opacity: .75; }
</style>
