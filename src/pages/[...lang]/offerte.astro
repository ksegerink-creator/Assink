---
import PageLayout from "@layouts/PageLayout.astro";
import FormExtras from "@components/forms/FormExtras.astro";
import { t } from "@data/i18n";
import { toLocale } from "@utils/paths";
import { readPage } from "@utils/content";
import { LOCALE_PATHS } from "@utils/locales";
import SectionHead from "@components/sections/SectionHead.astro";
import IndustrialImage from "@components/media/IndustrialImage.astro";
import { CONTACT } from "@data/site";
import { photo } from "@utils/photos";

export function getStaticPaths() {
  return LOCALE_PATHS;
}

const locale = toLocale(Astro.params.lang);
const o = await readPage("offerte", locale);

const services = t(locale, "operations").split(",");
const fileMsgs = {
  remove: t(locale, "formFileRemove"),
  tooBig: t(locale, "formFileTooBig"),
  tooMany: t(locale, "formFileTooMany"),
  totalTooBig: t(locale, "formFileTotalTooBig"),
  typeInvalid: t(locale, "formFileTypeInvalid"),
};
---
<PageLayout
  title={o.seoTitel}
  description={o.seoOmschrijving}
  canonicalSlug="offerte"
  trail={[{ label: t(locale, "quote"), slug: "offerte" }]}
  altLocales={["nl", "en", "de"]}
  ogPhoto={photo(o.werkFoto)}
>
  <section class="sec ov-hero">
    <div class="wrap ov-grid">
      <div>
        <span class="eyebrow mono"><b>{o.kicker}</b></span>
        <h1>{o.titel}</h1>
        <p class="lead">{o.lead}</p>
      </div>
      <figure class="ov-photo">
        <IndustrialImage src={photo(o.werkFoto)} alt="Werkvoorbereiding aan de machinebesturing" ratio="4/3" />
      </figure>
    </div>
  </section>

  <section class="sec tight">
    <div class="wrap">
      <div class="steps">
        {o.stappen.map((s, i) => (
          <div class="step">
            <span class="step__n mono">{String(i + 1).padStart(2, "0")}</span>
            <h3>{s.titel}</h3>
            <p>{s.tekst}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="sec tight">
    <div class="wrap">
      <SectionHead title={t(locale, "formHead")} index={t(locale, "formIndex")} />
      <form class="form rv" method="post" action="/api/aanvraag" enctype="multipart/form-data">
        <div class="form__grid">
          <label>{t(locale, "formName")}<input type="text" name="naam" autocomplete="name" required /></label>
          <label>{t(locale, "formCompany")}<input type="text" name="bedrijf" autocomplete="organization" required /></label>
          <label>{t(locale, "formEmail")}<input type="email" name="email" autocomplete="email" required /></label>
          <label>{t(locale, "formPhone")}<input type="tel" name="telefoon" autocomplete="tel" /></label>
        </div>
        <div class="form__grid">
          <label>{t(locale, "formOperation")}
            <select name="bewerking">
              {services.map((s) => <option value={s}>{s}</option>)}
            </select>
          </label>
          <label>{t(locale, "formQuantity")}<input type="text" name="aantal" placeholder={t(locale, "formQuantityPlaceholder")} /></label>
        </div>
        <label>{t(locale, "formNotes")}
          <textarea name="toelichting" rows="5" placeholder={t(locale, "formNotesPlaceholder")} required></textarea>
        </label>
        <div class="file">
          <span class="file__label">{t(locale, "formFile")}</span>
          <div class="dropzone" data-dropzone>
            <div class="dropzone__zone">
              <input
                type="file"
                name="tekeningen"
                id="tekeningen"
                multiple
                accept=".pdf,.dwg,.dxf,.step,.stp,.png,.jpg,.jpeg"
                data-fileinput
              />
              <label for="tekeningen" class="dropzone__label">
                <span class="dropzone__cta">{t(locale, "formFileCta")}</span>
                <span class="dropzone__hint mono">{t(locale, "formFileHint")} · {t(locale, "formFileLimits")}</span>
              </label>
            </div>
            <ul class="dropzone__list" data-filelist hidden></ul>
          </div>
          <p class="dropzone__error mono" data-fileerror hidden></p>
        </div>
        <FormExtras soort="offerte" />
        <div class="form__foot">
          <button class="btn" type="submit">{t(locale, "formSubmit")} <span class="arr">→</span></button>
          <a class="btn ghost" href={CONTACT.telHref}>{t(locale, "formOrCall")} {CONTACT.tel}</a>
        </div>
      </form>
    </div>
  </section>
</PageLayout>

<style>
  .ov-hero { padding-block: clamp(30px, 4vw, 52px) clamp(20px, 3vw, 36px); }
  .ov-grid { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, .8fr); gap: clamp(24px, 4vw, 64px); align-items: center; }
  .ov-photo { margin: 0; max-width: 440px; justify-self: end; }
  @media (max-width: 780px) { .ov-grid { grid-template-columns: 1fr; } .ov-photo { display: none; } }
  .ov-hero h1 { font-size: clamp(38px, 5.4vw, 74px); }
  .ov-hero .lead { max-width: 36em; color: var(--ink-2); font-size: clamp(16px, 1.4vw, 19px); margin-top: 18px; }
  .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(18px, 2vw, 28px); }
  .step { border-top: 1px solid var(--ink); padding-top: 16px; }
  .step__n { color: var(--blue); }
  .step h3 { font-size: clamp(18px, 2vw, 24px); margin: 10px 0 8px; }
  .step p { color: var(--ink-2); font-size: 15px; }
  .form { display: grid; gap: 18px; max-width: 820px; }
  .form__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  .form label { display: grid; gap: 7px; font-family: var(--f-mono); font-size: 11.5px; letter-spacing: .06em; text-transform: uppercase; color: var(--steel); }
  .form input, .form textarea, .form select {
    font-family: var(--f-body); font-size: 16px; color: var(--ink); background: var(--surface);
    border: 1px solid var(--line); padding: 12px 14px; width: 100%;
  }
  .form input:focus, .form textarea:focus, .form select:focus { outline: 2px solid var(--blue); outline-offset: 1px; border-color: var(--blue); }
  .form textarea { resize: vertical; }
  .file { display: grid; gap: 7px; }
  .file__label { font-family: var(--f-mono); font-size: 11.5px; letter-spacing: .06em; text-transform: uppercase; color: var(--steel); }
  .form__foot { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
  @media (max-width: 720px) { .steps, .form__grid { grid-template-columns: 1fr; } }

  .dropzone { border: 1px dashed var(--line); background: var(--surface); transition: border-color .15s, background .15s; }
  .dropzone[data-over] { border-color: var(--blue); background: var(--sky-bg); }
  .dropzone__zone { position: relative; }
  .dropzone__zone input[data-fileinput] {
    position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer;
  }
  .dropzone__label {
    display: grid; gap: 4px; justify-items: center; text-align: center;
    padding: 22px 16px; cursor: pointer; pointer-events: none;
  }
  .dropzone__cta { font-family: var(--f-body); font-size: 15px; color: var(--ink); text-transform: none; letter-spacing: 0; }
  .dropzone__hint { color: var(--steel); font-size: 11.5px; }
  .dropzone__list {
    list-style: none; margin: 0; padding: 10px 14px 14px; display: grid; gap: 6px;
    border-top: 1px solid var(--line);
  }
  .dropzone__list li {
    display: flex; align-items: center; justify-content: space-between; gap: 10px;
    font-family: var(--f-body); font-size: 14px; color: var(--ink);
  }
  .dropzone__list .fname { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .dropzone__list .fsize { flex: none; color: var(--steel); font-family: var(--f-mono); font-size: 11.5px; }
  .dropzone__list button {
    flex: none; border: none; background: none; color: var(--steel); cursor: pointer;
    font-family: var(--f-mono); font-size: 12px; text-decoration: underline; text-underline-offset: 2px; padding: 0;
  }
  .dropzone__list button:hover { color: #B4472A; }
  .dropzone__error {
    color: #B4472A; font-size: 12px;
  }
</style>

<script define:vars={{ msgs: fileMsgs }}>
  /**
   * Sleep-en-klik-bestandskeuze voor het offerteformulier. We houden de
   * geselecteerde bestanden zelf bij in `files` (niet alleen in het native
   * <input>), omdat een nieuwe klik-op-kiezen anders de vorige keuze
   * vervangt in plaats van aanvult. Voor verzending zetten we `files` via
   * een DataTransfer terug op het echte <input>, zodat de gewone
   * FormData(form)-afhandeling in FormExtras.astro ongewijzigd blijft werken.
   */
  const ALLOWED = [".pdf", ".dwg", ".dxf", ".step", ".stp", ".png", ".jpg", ".jpeg"];
  const MAX_BYTES = 10 * 1024 * 1024;
  const MAX_TOTAL = 20 * 1024 * 1024;
  const MAX_FILES = 6;

  const zone = document.querySelector("[data-dropzone]");
  if (zone) {
    const input = zone.querySelector("[data-fileinput]");
    const list = zone.querySelector("[data-filelist]");
    const errorEl = zone.parentElement?.querySelector("[data-fileerror]");
    let files = [];

    const fmt = (bytes) =>
      bytes >= 1024 * 1024 ? `${(bytes / (1024 * 1024)).toFixed(1)} MB` : `${Math.ceil(bytes / 1024)} KB`;

    function showError(msg) {
      if (!errorEl) return;
      errorEl.textContent = msg;
      errorEl.hidden = !msg;
    }

    function sync() {
      const dt = new DataTransfer();
      files.forEach((f) => dt.items.add(f));
      input.files = dt.files;

      list.innerHTML = "";
      list.hidden = files.length === 0;
      files.forEach((f, i) => {
        const li = document.createElement("li");
        const name = document.createElement("span");
        name.className = "fname";
        name.textContent = f.name;
        const size = document.createElement("span");
        size.className = "fsize";
        size.textContent = fmt(f.size);
        const btn = document.createElement("button");
        btn.type = "button";
        btn.textContent = msgs.remove;
        btn.addEventListener("click", () => {
          files.splice(i, 1);
          sync();
        });
        li.append(name, size, btn);
        list.append(li);
      });
    }

    function addFiles(incoming) {
      showError("");
      for (const f of Array.from(incoming)) {
        if (files.some((x) => x.name === f.name && x.size === f.size)) continue;
        const ext = f.name.slice(f.name.lastIndexOf(".")).toLowerCase();
        if (!ALLOWED.includes(ext)) {
          showError(`${f.name} ${msgs.typeInvalid}`);
          continue;
        }
        if (f.size > MAX_BYTES) {
          showError(`${f.name} ${msgs.tooBig}`);
          continue;
        }
        if (files.length >= MAX_FILES) {
          showError(msgs.tooMany);
          break;
        }
        const totaal = files.reduce((s, x) => s + x.size, 0) + f.size;
        if (totaal > MAX_TOTAL) {
          showError(msgs.totalTooBig);
          break;
        }
        files.push(f);
      }
      sync();
    }

    input.addEventListener("change", () => addFiles(input.files));

    ["dragenter", "dragover"].forEach((evt) =>
      zone.addEventListener(evt, (e) => {
        e.preventDefault();
        zone.setAttribute("data-over", "");
      }),
    );
    ["dragleave", "dragend", "drop"].forEach((evt) =>
      zone.addEventListener(evt, (e) => {
        e.preventDefault();
        zone.removeAttribute("data-over");
      }),
    );
    zone.addEventListener("drop", (e) => {
      if (e.dataTransfer?.files?.length) addFiles(e.dataTransfer.files);
    });
  }
</script>
