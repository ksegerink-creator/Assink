---
import PageLayout from "@layouts/PageLayout.astro";
import { SITE, CONTACT } from "@data/site";
import { readPage } from "@utils/content";
import { toLocale } from "@utils/paths";
import { LOCALE_PATHS } from "@utils/locales";

/**
 * Privacyverklaring in NL, EN en DE, op noindex. Nederlands is de bron; de
 * Engelse en Duitse tekst staan in hetzelfde CMS-scherm (blok "Engelse/Duitse
 * vertaling") en vallen per veld terug op het Nederlands.
 *
 * De tekst komt uit het CMS (src/content/pages/privacy.yaml). Het is een
 * juridisch document dat zonder tussenkomst van een ontwikkelaar bij te werken
 * moet zijn; vandaar dat ook de paragrafen een CMS-lijst zijn in plaats van
 * vaste markup.
 *
 * In de teksten mogen {bedrijf}, {adres}, {email} en {telefoon} staan. Die
 * vullen we hier in uit Bedrijfsgegevens, zodat een nieuw adres of
 * telefoonnummer niet op twee plekken hoeft te worden bijgewerkt. E-mail en
 * telefoon worden daarbij een echte link.
 */
export function getStaticPaths() {
  return LOCALE_PATHS;
}

const locale = toLocale(Astro.params.lang);
const pg = await readPage("privacy", locale);

const escape = (v: string) =>
  v.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");

/** Vult de plaatshouders in en maakt van e-mail en telefoon een link. */
const fill = (tekst: string) =>
  escape(tekst)
    .replaceAll("{bedrijf}", escape(SITE.legalName))
    .replaceAll("{adres}", escape(CONTACT.addr))
    .replaceAll("{email}", `<a href="mailto:${escape(CONTACT.email)}">${escape(CONTACT.email)}</a>`)
    .replaceAll("{telefoon}", `<a href="${escape(CONTACT.telHref)}">${escape(CONTACT.tel)}</a>`);

/**
 * Een lege regel in het CMS-tekstveld begint een nieuwe alinea. Zo kan een
 * langere paragraaf (zoals die over het formulier) leesbaar blijven zonder
 * extra koppen.
 */
const alineas = (tekst: string) =>
  tekst
    .split(/\n\s*\n/)
    .map((a) => a.trim())
    .filter(Boolean);

/** De introzin staat buiten de prose-kolom; daar willen we geen links in. */
const plain = (tekst: string) =>
  tekst
    .replaceAll("{bedrijf}", SITE.legalName)
    .replaceAll("{adres}", CONTACT.addr)
    .replaceAll("{email}", CONTACT.email)
    .replaceAll("{telefoon}", CONTACT.tel);
---
<PageLayout
  title={pg.seoTitel}
  description={pg.seoOmschrijving}
  canonicalSlug="privacy"
  altLocales={["nl", "en", "de"]}
  trail={[{ label: pg.titel, slug: "privacy" }]}
  noindex={true}
>
  <section class="sec ov-hero">
    <div class="wrap">
      <span class="eyebrow mono"><b>{pg.kicker}</b></span>
      <h1>{pg.titel}</h1>
      <p class="lead">{plain(pg.lead)}</p>
    </div>
  </section>

  <section class="sec tight">
    <div class="wrap-narrow">
      <div class="prose rv">
        {
          pg.secties.map((sec) => (
            <>
              <h3>{sec.kop}</h3>
              {alineas(sec.tekst).map((alinea) => <p set:html={fill(alinea)} />)}
            </>
          ))
        }
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .ov-hero { padding-block: clamp(30px, 4vw, 52px) clamp(20px, 3vw, 36px); }
  .ov-hero h1 { font-size: clamp(36px, 5vw, 66px); }
  .ov-hero .lead { max-width: 34em; color: var(--ink-2); font-size: clamp(16px, 1.4vw, 19px); margin-top: 18px; }
</style>
