---
import PageLayout from "@layouts/PageLayout.astro";
import FormExtras from "@components/forms/FormExtras.astro";
import { t, formatOpeningHours } from "@data/i18n";
import { toLocale, localizePath } from "@utils/paths";
import { readPage } from "@utils/content";
import { LOCALE_PATHS } from "@utils/locales";
import IndustrialImage from "@components/media/IndustrialImage.astro";
import SocialSection from "@components/sections/SocialSection.astro";
import { CONTACT } from "@data/site";
import { photo } from "@utils/photos";

export function getStaticPaths() {
  return LOCALE_PATHS;
}

const locale = toLocale(Astro.params.lang);
const c = await readPage("contact", locale);
const nav = (slug: string) => localizePath(slug, locale);
---
<PageLayout
  title={c.seoTitel}
  description={c.seoOmschrijving}
  canonicalSlug="contact"
  trail={[{ label: t(locale, "contact"), slug: "contact" }]}
  altLocales={["nl", "en", "de"]}
  ogPhoto={photo(c.pandFoto)}
>
  <!-- Kop + gegevens + pand in één compacte compositie -->
  <section class="sec chead">
    <div class="wrap chead__grid">
      <div class="rv">
        <span class="mono chead__kicker">{c.kicker}</span>
        <h1>{c.titel}</h1>
        <p class="chead__lead">{c.lead}</p>

        <div class="info">
          <div><span class="k">{t(locale, "formAddress")}</span><span>{CONTACT.addr}</span></div>
          <div><span class="k">{t(locale, "formPhone")}</span><a href={CONTACT.telHref}>{CONTACT.tel}</a></div>
          <div><span class="k">{t(locale, "formEmail")}</span><a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></div>
          {CONTACT.openingstijden && <div><span class="k">{t(locale, "formOpeningHours")}</span><span>{formatOpeningHours(locale, CONTACT.openingHours, CONTACT.openingstijden)}</span></div>}
          {CONTACT.kvk && <div><span class="k">{t(locale, "formKvk")}</span><span>{CONTACT.kvk}</span></div>}
        </div>
        <div class="chead__acts">
          <a class="btn" href={nav("offerte")}>{t(locale, "quote")}</a>
          {CONTACT.maps && <a class="btn ghost" href={CONTACT.maps} target="_blank" rel="noopener noreferrer">{t(locale, "routeMap")}</a>}
        </div>
      </div>

      <figure class="chead__photo rv">
        <IndustrialImage src={photo(c.pandFoto)} alt={t(locale, "altBuilding")} ratio="4/5" />
        <figcaption class="mono">{c.pandBijschrift}</figcaption>
      </figure>
    </div>
  </section>

  <!-- Bericht sturen -->
  <section class="sec tight cform">
    <div class="wrap cform__grid">
      <div class="rv">
        <h2>{c.berichtKop}</h2>
        <p class="cform__note">{c.berichtNote}</p>
        <figure class="cform__photo">
          <IndustrialImage src={photo(c.werkFoto)} alt={t(locale, "altPressTool")} ratio="4/3" />
        </figure>
      </div>
      <form class="form rv" method="post" action="/api/aanvraag">
        <div class="form__grid">
          <label>{t(locale, "formName")}<input type="text" name="naam" autocomplete="name" required /></label>
          <label>{t(locale, "formCompany")}<input type="text" name="bedrijf" autocomplete="organization" /></label>
          <label>{t(locale, "formEmail")}<input type="email" name="email" autocomplete="email" required /></label>
          <label>{t(locale, "formPhone")}<input type="tel" name="telefoon" autocomplete="tel" /></label>
        </div>
        <label>{t(locale, "formMessage")}<textarea name="bericht" rows="6" required></textarea></label>
        <FormExtras soort="contact" />
        <button class="btn" type="submit">{t(locale, "sendMessage")} <span class="arr">→</span></button>
      </form>
    </div>
  </section>

  <SocialSection variant="band" locale={locale} lead={t(locale, "socialLeadContact")} />
</PageLayout>

<style>
  .chead { padding-block: clamp(28px, 4vw, 56px) clamp(36px, 5vw, 64px); }
  .chead__grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); gap: clamp(28px, 5vw, 80px); align-items: start; }
  .chead__kicker { color: var(--steel); letter-spacing: .14em; }
  .chead h1 { font-size: clamp(36px, 5vw, 68px); margin-top: 12px; }
  .chead__lead { margin: 18px 0 26px; color: var(--ink-2); max-width: 30em; font-size: clamp(15.5px, 1.4vw, 18px); }
  .chead__acts { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 24px; }
  .chead__photo { margin: 0; max-width: 460px; justify-self: end; }
  .chead__photo figcaption { margin-top: 10px; color: var(--steel); letter-spacing: .1em; font-size: 10.5px; }
  @media (max-width: 780px) { .chead__grid { grid-template-columns: 1fr; } .chead__photo { justify-self: stretch; max-width: none; } }

  .cform { background: var(--surface-2); padding-block: clamp(40px, 6vw, 80px); }
  .cform__grid { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(28px, 4.5vw, 72px); align-items: start; }
  .cform h2 { font-size: clamp(24px, 2.8vw, 36px); }
  .cform__note { margin-top: 12px; color: var(--ink-2); font-size: 15px; max-width: 28em; }
  .cform__note a { color: var(--blue); text-decoration: underline; text-underline-offset: 3px; }
  .cform__photo { margin: 26px 0 0; max-width: 380px; }
  .form { display: grid; gap: 18px; }
  .form__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  .form label { display: grid; gap: 7px; font-family: var(--f-mono); font-size: 11.5px; letter-spacing: .06em; text-transform: uppercase; color: var(--steel); }
  .form input, .form textarea {
    font-family: var(--f-body); font-size: 16px; color: var(--ink); background: var(--surface);
    border: 1px solid var(--line); padding: 12px 14px; width: 100%;
  }
  .form input:focus, .form textarea:focus { outline: 2px solid var(--blue); outline-offset: 1px; border-color: var(--blue); }
  .form textarea { resize: vertical; }
  .form .btn { justify-self: start; }
  .form__hint { color: var(--steel); font-size: 10.5px; letter-spacing: .08em; }
  @media (max-width: 780px) { .cform__grid, .form__grid { grid-template-columns: 1fr; } .cform__photo { display: none; } }
</style>
