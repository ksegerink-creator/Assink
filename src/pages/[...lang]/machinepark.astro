---
import { getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import { t } from "@data/i18n";
import { toLocale } from "@utils/paths";
import { readPage, localizeEntries } from "@utils/content";
import { LOCALE_PATHS } from "@utils/locales";
import SectionHead from "@components/sections/SectionHead.astro";
import { machineImageFor } from "@data/images";
import IndustrialImage from "@components/media/IndustrialImage.astro";
import SplitHero from "@components/sections/SplitHero.astro";
import CtaBand from "@components/sections/CtaBand.astro";
import { photo } from "@utils/photos";
import { kiesFoto } from "@utils/fotobank";

export function getStaticPaths() {
  return LOCALE_PATHS;
}

const locale = toLocale(Astro.params.lang);
const m0 = await readPage("machinepark", locale);

const machines = localizeEntries((await getCollection("machines")).sort((a, b) => a.data.order - b.data.order), locale);

// Beelden vooraf oplossen: in de opmaak zelf kan geen await staan.
const machineBeelden = await Promise.all(
  machines.map(async (m) => ({ m, machineImg: (await kiesFoto(m.data.foto, m.data.fotoBank)) ?? machineImageFor(m.id) })),
);
---
<PageLayout
  title={m0.seoTitel}
  description={m0.seoOmschrijving}
  canonicalSlug="machinepark"
  trail={[{ label: t(locale, "machinepark"), slug: "machinepark" }]}
  altLocales={["nl", "en", "de"]}
  ogPhoto={await kiesFoto(m0.heroFoto, m0.heroFotoBank)}
>
  <SplitHero
    kicker={m0.kicker}
    title={m0.titel}
    lead={m0.lead}
    image={await kiesFoto(m0.heroFoto, m0.heroFotoBank)}
    alt={t(locale, "altHallOverview")}
  />

  <section class="sec">
    <div class="wrap">
      <SectionHead title={t(locale, "machinesHead")} index={`${machines.length} ${t(locale, "machinesIndex")}`} />
      <div class="mp rv">
        {machineBeelden.map(({ m, machineImg }, i) => {
          return (
          <article class:list={["mp__row", { "mp__row--no-media": !machineImg }]}>
            {machineImg && (
              <div class="mp__media">
                <IndustrialImage src={machineImg} alt={m.data.photo.subject} ratio="4/3" />
              </div>
            )}
            <div class="mp__body">
              <span class="mp__cat mono">{String(i + 1).padStart(2, "0")} · {m.data.category}</span>
              <h3>{m.data.name}</h3>
              <p>{m.data.description}</p>
              {m.data.specs.length > 0 && (
                <div class="tbl-wrap">
                  <table class="tbl">
                    <tbody>
                      {m.data.specs.map((r) => (
                        <tr><th scope="row">{r.label}</th><td class="spec">{r.value}</td></tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}
            </div>
          </article>
          );
        })}
      </div>
    </div>
  </section>

  <CtaBand />
</PageLayout>

<style>
  .ov-hero { padding-block: clamp(30px, 4vw, 52px) clamp(40px, 6vw, 72px); }
  .ov-hero .grid2 { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr); gap: clamp(28px, 4vw, 56px); align-items: center; }
  .ov-hero h1 { font-size: clamp(40px, 6vw, 82px); }
  .ov-hero .lead { max-width: 34em; color: var(--ink-2); font-size: clamp(16px, 1.4vw, 19px); margin-top: 20px; }
  .mp { display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(28px, 4vw, 52px); }
  .mp__row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: clamp(20px, 3vw, 44px); align-items: start; padding-bottom: clamp(28px, 4vw, 52px); border-bottom: 1px solid var(--line); }
  .mp__row--no-media { grid-template-columns: 1fr; }
  .mp__row:last-child { border-bottom: 0; padding-bottom: 0; }
  .mp__cat { color: var(--blue); }
  .mp__body h3 { font-size: clamp(22px, 2.6vw, 34px); margin: 8px 0 12px; }
  .mp__body p { color: var(--ink-2); max-width: 40em; margin-bottom: 18px; }
  /* Kaal 1fr geeft een kolom met min-width: auto: die kan niet kleiner worden
     dan zijn inhoud, en de foto duwde de rij op een 320px-scherm 34px buiten
     beeld. minmax(0, 1fr) laat de kolom wel krimpen. */
  @media (max-width: 820px) { .ov-hero .grid2, .mp__row { grid-template-columns: minmax(0, 1fr); } }
</style>
