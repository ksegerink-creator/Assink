---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import { t } from "@data/i18n";
import SectionHead from "@components/sections/SectionHead.astro";
import IndustrialImage from "@components/media/IndustrialImage.astro";
import SplitHero from "@components/sections/SplitHero.astro";
import { imageFor } from "@data/images";
import { photo } from "@utils/photos";
import { kiesFoto } from "@utils/fotobank";
import { CONTACT, SITE } from "@data/site";
import { jobPostingJsonLd, googleDienstverband } from "@utils/seo";
import { toLocale, localizePath } from "@utils/paths";
import { localizeEntry, readPage } from "@utils/content";
import { LOCALES } from "@utils/locales";

export async function getStaticPaths() {
  const vacancies = await getCollection("vacancies");
  // Elke vacature × elke taal; lang=undefined levert de Nederlandse route.
  return vacancies.flatMap((entry: CollectionEntry<"vacancies">) =>
    LOCALES.map((loc) => ({
      params: { lang: loc === "nl" ? undefined : loc, slug: entry.data.slug },
      props: { entry },
    })),
  );
}

interface Props { entry: CollectionEntry<"vacancies"> }
const { entry } = Astro.props;
const locale = toLocale(Astro.params.lang);
const v = localizeEntry(entry.data, locale);
const nav = (slug: string) => localizePath(slug, locale);
const site = Astro.site ?? new URL(SITE.url);
// Google for Jobs toont een vacature zonder einddatum korter. De site is
// statisch: validThrough ligt 3 maanden na de build, en elke publicatie (CMS,
// blog-cron) schuift hem op. Zolang een vacature open staat, blijft hij dus
// staan; gaat hij dicht, dan verdwijnt de pagina.
const vandaag = new Date();
const totEn = new Date(vandaag);
totEn.setMonth(totEn.getMonth() + 3);
const isoDatum = (d: Date) => d.toISOString().slice(0, 10);
const jsonld = [
  jobPostingJsonLd(site, {
    title: v.title,
    description: v.intro,
    employmentType: v.employmentType,
    datePosted: v.geplaatst ?? isoDatum(vandaag),
    validThrough: isoDatum(totEn),
    salaris: { min: v.salarisMin, max: v.salarisMax, per: v.salarisPer },
  }),
];

// Tijdelijk sfeerbeeld per vacature (officiële fotografie volgt).
const VAC_IMG: Record<string, string> = {
  "bankwerker-lasser": "vacatures.detail",
  "kanter-zetter": "home.plaatwerk",
  "junior-laser-operator": "home.snijden",
  "werkvoorbereider-tekenaar": "contact.werk",
  "stage": "vacatures.sfeer.1",
  "vakantiewerk": "vacatures.sfeer.2",
  "constructiebankwerker-lasser-junior": "vacatures.detail",
  "constructiebankwerker-lasser-senior": "vacatures.detail",
  "constructiebankwerker-lasser-bbl": "vacatures.sfeer.1",
  "gepensioneerde-chauffeur": "vacatures.sfeer.2",
};
// Arbeidsvoorwaarden staan één keer op de pagina Werken bij en gelden voor
// medewerkers in dienst. Bij stage en vakantiewerk tonen we ze niet: daar
// gelden niet automatisch dezelfde voorwaarden (CAO, ADV).
const werkenBij = await readPage("werkenBij", locale);
// Heeft de vacature eigen voorwaarden, dan gaan die vóór het algemene blok.
const inDienst = ["FULL_TIME", "PART_TIME"].includes(googleDienstverband(v.employmentType));
const eigenAanbod = v.aanbod.filter(Boolean);
const bieden = eigenAanbod.length ? eigenAanbod : inDienst ? (werkenBij.bieden ?? []).filter(Boolean) : [];
const biedenKop = eigenAanbod.length ? t(locale, "vacancyOffer") : werkenBij.biedenKop || t(locale, "vacancyOffer");

// "€ 2.400 – € 3.500 bruto per maand", in de notatie van de taal.
const euro = new Intl.NumberFormat({ nl: "nl-NL", en: "en-GB", de: "de-DE" }[locale], {
  style: "currency", currency: "EUR", maximumFractionDigits: 0,
});
const bedragen = [v.salarisMin, v.salarisMax].filter((b): b is number => !!b).map((b) => euro.format(b));
const salaris = bedragen.length
  ? `${bedragen.join(" – ")} ${t(locale, v.salarisPer === "uur" ? "vacancySalaryHour" : "vacancySalaryMonth")}`
  : undefined;

const mailHref = `mailto:${CONTACT.sollicitatieEmail}?subject=${encodeURIComponent(t(locale, "applySubject") + " " + v.title)}`;

const vacImage = await kiesFoto(v.foto, v.fotoBank) ?? imageFor(VAC_IMG[v.slug] ?? "vacatures.sfeer.1");
---
<PageLayout
  title={v.title}
  description={v.seoOmschrijving || v.intro}
  canonicalSlug={`vacatures/${v.slug}`}
  altLocales={["nl", "en", "de"]}
  trail={[{ label: t(locale, "careers"), slug: "vacatures" }, { label: v.title, slug: `vacatures/${v.slug}` }]}
  ogPhoto={vacImage}
  jsonld={jsonld}
>
  <SplitHero
    kicker={t(locale, "vacancyEyebrow")}
    title={v.title}
    lead={v.intro}
    image={vacImage}
    alt={v.photo.subject}
    placeholder={`Foto benodigd — ${v.photo.subject}`}
  >
    <div class="badges">
      <span class="badge"><b>◆</b> {v.employmentType}</span>
      {v.hours && <span class="badge">{v.hours}</span>}
      {v.education && <span class="badge">{v.education}</span>}
      {salaris && <span class="badge">{salaris}</span>}
      {!v.open && <span class="badge">{t(locale, "vacancyClosed")}</span>}
    </div>
    <div class="vd-acts">
      {v.sollicitatieLink
        ? <a class="btn" href={v.sollicitatieLink} rel="noopener">{t(locale, "vacancyApplyLink")}</a>
        : <a class="btn" href={mailHref}>{t(locale, "vacancyApplyMail")}</a>}
      <a class="btn ghost" href={CONTACT.telHref}>{t(locale, "callVerb")} {CONTACT.tel}</a>
    </div>
  </SplitHero>

  {v.responsibilities.length > 0 && (
    <section class="sec tight">
      <div class="wrap">
        <SectionHead title={t(locale, "vacancyTasks")} index={t(locale, "vacancyTasksIdx")} />
        <ul class="ticklist prose rv">
          {v.responsibilities.map((r) => <li>{r}</li>)}
        </ul>
      </div>
    </section>
  )}

  {v.requirements.length > 0 && (
    <section class="sec tight">
      <div class="wrap">
        <SectionHead title={t(locale, "vacancyProfile")} index={t(locale, "vacancyProfileIdx")} />
        <ul class="ticklist prose rv">
          {v.requirements.map((r) => <li>{r}</li>)}
        </ul>
      </div>
    </section>
  )}

  {bieden.length > 0 && (
    <section class="sec tight">
      <div class="wrap">
        <SectionHead title={biedenKop} index={t(locale, "vacancyOfferIdx")} />
        <ul class="ticklist prose rv">
          {bieden.map((b) => <li>{b}</li>)}
        </ul>
      </div>
    </section>
  )}

  <section class="sec band">
    <div class="wrap cta-band rv">
      <div>
        <span class="eyebrow mono">{t(locale, "vacancyInterest")}</span>
        <h2>{t(locale, "vacancyApplyHead")}<br /><span class="alt">{t(locale, "vacancyApplyAt")}</span></h2>
      </div>
      <div class="acts">
        {v.sollicitatieLink
          ? <a class="btn" href={v.sollicitatieLink} rel="noopener">{t(locale, "vacancyApplyLink")}</a>
          : <a class="btn" href={mailHref}>{t(locale, "vacancyMailUs")}</a>}
        <a class="btn ghost" href={nav("contact")}>{t(locale, "contact")}</a>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .vd-hero { padding-block: clamp(20px, 3vw, 40px) clamp(36px, 5vw, 64px); }
  .vd-hero .grid2 { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(28px, 4vw, 56px); align-items: center; }
  .vd-hero h1 { font-size: clamp(34px, 5vw, 64px); }
  .vd-hero .lead { max-width: 36em; color: var(--ink-2); font-size: clamp(16px, 1.4vw, 19px); }
  .vd-hero .acts { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 24px; }
  .ticklist { list-style: none; padding: 0; }
  .ticklist li { position: relative; padding-left: 28px; }
  .ticklist li::before { content: ""; position: absolute; left: 0; top: .6em; width: 14px; height: 1px; background: var(--blue); }
  .acts { display: flex; flex-wrap: wrap; gap: 12px; }
  @media (max-width: 820px) { .vd-hero .grid2 { grid-template-columns: 1fr; } }
</style>
