---
import PageLayout from "@layouts/PageLayout.astro";
import FormExtras from "@components/forms/FormExtras.astro";
import IndustrialImage from "@components/media/IndustrialImage.astro";
import CtaBand from "@components/sections/CtaBand.astro";
import SocialSection from "@components/sections/SocialSection.astro";
import { SITE, CONTACT, CERTS } from "@data/site";
import { t } from "@data/i18n";
import { localizePath, toLocale } from "@utils/paths";
import { photo } from "@utils/photos";
import { readPage } from "@utils/content";
import { LOCALE_PATHS } from "@utils/locales";

/**
 * Homepage — compact, foto-geleid, editorial.
 * Alle teksten en foto's komen uit de Keystatic-singleton `homepage`
 * (src/content/pages/home, met en/ + de/ voor de vertalingen). Beheer via
 * /keystatic. Beeldverhoudingen en layout blijven in code.
 */
export function getStaticPaths() {
  return LOCALE_PATHS;
}

const locale = toLocale(Astro.params.lang);
const nav = (slug: string) => localizePath(slug, locale);
const years = new Date().getFullYear() - SITE.founded;
const fill = (s: string | null | undefined) => (s ?? "").replaceAll("{jaren}", String(years));

const home = await readPage("homepage", locale);

const { hero, intro, capabilities, proef, mensen } = home;
// Vaste beeldverhoudingen/annotatie-styling per tegel (blijft in code).
const capRatios = ["3/2", "4/3", "3/2", "4/3"];
---

<PageLayout title={home.seoTitel} description={home.seoOmschrijving} canonicalSlug="" altLocales={["nl", "en", "de"]} ogPhoto={photo(hero.foto)}>
  <!-- ═══ Hero — full-bleed fotografie met rustige tekstlaag ═══ -->
  <section class="hero">
    <div class="hero__media">
      <IndustrialImage
        src={photo(hero.foto)}
        alt="Lasser van Assink & Schipholt aan het werk in de productiehal"
        ratio="21/10"
        priority={true}
        position="60% 40%"
        class="hero__img"
      />
      <div class="hero__scrim" aria-hidden="true"></div>
    </div>
    <div class="wrap hero__inner">
      <div class="hero__lede">
        <p class="hero__kicker mono">{hero.kicker}</p>
        <h1>{hero.titelRegel1}<br />{hero.titelRegel2}<span class="dot">.</span></h1>
        <p class="hero__copy">{hero.copy}</p>
        <a class="hero__more mono" href={nav("plaatwerk")}>{t(locale, "allCaps")} →</a>
      </div>

      <!-- Direct een aanvraag doen, zonder doorklikken -->
      <form class="hform" method="post" action="/api/aanvraag" aria-labelledby="hform-h">
        <h2 id="hform-h" class="hform__h">{hero.formulierTitel}</h2>
        <label>{t(locale, "formName")}<input type="text" name="naam" autocomplete="name" required /></label>
        <div class="hform__row">
          <label>{t(locale, "formEmail")}<input type="email" name="email" autocomplete="email" required /></label>
          <label>{t(locale, "formPhone")}<input type="tel" name="telefoon" autocomplete="tel" /></label>
        </div>
        <label>{t(locale, "formSubject")}<textarea name="omschrijving" rows="3" placeholder={t(locale, "formSubjectPlaceholder")} required></textarea></label>
        <FormExtras soort="hero" />
        <button class="btn hform__btn" type="submit">{t(locale, "formSubmit")} <span class="arr">→</span></button>
        <p class="hform__hint mono">{t(locale, "formHintResponse")} · {t(locale, "formHintDrawing")} <a href={nav("offerte")}>{t(locale, "formHintFull")}</a> · {t(locale, "formHintDirect")} <a href={CONTACT.telHref}>{CONTACT.tel}</a></p>
      </form>
    </div>
    <div class="wrap hero__meta mono">
      {t(locale, "heroMeta").split(",").map((label) => <span>{label}</span>)}
    </div>
  </section>

  <!-- ═══ Intro — verhaal + feiten links, het pand rechts ═══ -->
  <section class="sec intro">
    <div class="wrap intro__grid">
      <div class="intro__text rv">
        <h2 class="intro__h">{intro.kop}</h2>
        <p class="prose">
          {fill(intro.tekst)} <strong>{intro.tekstAccent}</strong>
        </p>
        <ul class="facts mono" aria-label={t(locale, "factsAria")}>
          {intro.feiten.map((f) => (
            <li><b>{fill(f.waarde)}</b> {f.label}</li>
          ))}
        </ul>
      </div>
      <figure class="intro__pand rv">
        <IndustrialImage
          src={photo(intro.pandFoto)}
          alt="Het bedrijfspand van Assink & Schipholt aan de Oosterveldsingel in Hengelo"
          ratio="16/10"
          position="center 32%"
        />
        <figcaption class="mono">{t(locale, "pandCaption")}</figcaption>
      </figure>
    </div>
  </section>

  <!-- ═══ Mogelijkheden — foto-geleide editorial rijen ═══ -->
  <section class="sec caps">
    <div class="wrap">
      <div class="rule-head rv">
        <h2>{home.capabilitiesKop}</h2>
        <span class="mono">{t(locale, "possibilities")}</span>
      </div>
      <div class="mosaic">
        {capabilities.map((c, i) => (
          <a class={`tile tile--${i % 4}`} href={nav(c.link)}>
            <IndustrialImage src={photo(c.foto)} alt={`${c.titel} — Assink & Schipholt`} ratio={capRatios[i % 4]} annotation={c.annotatie} class="tile__img" />
            <span class="tile__scrim" aria-hidden="true"></span>
            <span class="tile__idx mono" aria-hidden="true">{c.nummer}</span>
            <div class="tile__body">
              <h3>{c.titel}</h3>
              <p>{c.omschrijving}</p>
              <span class="tile__go mono">{t(locale, "readmore")} <span class="arr">→</span></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ Productie in beeld — brede foto + detailstrip ═══ -->
  <section class="proof">
    <figure class="proof__wide">
      <IndustrialImage
        src={photo(proef.quoteFoto)}
        alt="Lasser aan de lastafel bij Assink & Schipholt"
        ratio="21/8"
        position="center 55%"
      />
      <figcaption class="proof__quote wrap">
        <p>“{proef.quote}”</p>
      </figcaption>
    </figure>
    <div class="wrap proof__row">
      {proef.details.map((d) => (
        <figure class="rv">
          <IndustrialImage src={photo(d.foto)} alt={d.bijschrift} ratio="1/1" />
          <figcaption class="mono">{d.bijschrift}</figcaption>
        </figure>
      ))}
      <div class="proof__link rv">
        <p>{t(locale, "proofLink")}</p>
        <a class="btn ghost sm" href={nav("machinepark")}>{t(locale, "proofLinkBtn")}</a>
      </div>
    </div>
  </section>

  <!-- ═══ Mensen & bedrijf ═══ -->
  <section class="sec people">
    <div class="wrap people__grid">
      <figure class="people__photo rv">
        <IndustrialImage src={photo(mensen.foto)} alt="Vakman van Assink & Schipholt met een stalen profiel" ratio="4/5" position="center 35%" />
      </figure>
      <div class="people__text rv">
        <span class="eyebrow mono">{t(locale, "peopleEyebrow")}</span>
        <h2>{fill(mensen.kop)}</h2>
        <p class="prose">{mensen.tekst}</p>
        <p class="people__certs mono">{CERTS.join("  ·  ")}</p>
        <div class="people__acts">
          <a class="btn ghost" href={nav("over-ons")}>{t(locale, "peopleAbout")}</a>
          <a class="btn ghost" href={nav("vacatures")}>{t(locale, "careers")}</a>
        </div>
      </div>
    </div>
  </section>

  <SocialSection variant="plain" />

  <CtaBand />
</PageLayout>

<style>
  /* ── hero ─────────────────────────────────────────────── */
  .hero { position: relative; overflow: clip; background: var(--navy); }
  .hero__media { position: absolute; inset: 0; }
  .hero__media :global(.ii) { height: 100%; border: 0; }
  .hero__media :global(.ii img) { height: 100%; }
  .hero__scrim {
    position: absolute; inset: 0;
    background:
      linear-gradient(78deg, rgba(4, 26, 53, .88) 0%, rgba(4, 26, 53, .62) 38%, rgba(4, 26, 53, .18) 68%, rgba(4, 26, 53, .30) 100%),
      linear-gradient(rgba(4, 26, 53, 0) 55%, rgba(4, 26, 53, .55) 100%);
  }
  .hero__inner {
    position: relative; z-index: 2; padding-top: clamp(48px, 8vw, 110px);
    display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(300px, 420px);
    gap: clamp(28px, 5vw, 88px); align-items: center;
  }
  .hero__kicker { color: #9CC3DF; letter-spacing: .16em; }
  .hero h1 {
    margin-top: 18px; color: #fff;
    font-size: clamp(44px, 6.4vw, 96px); line-height: .95; letter-spacing: -.01em;
  }
  .hero .dot { color: var(--sky); }
  .hero__copy { margin-top: 22px; max-width: 30em; color: #D7E4F0; font-size: clamp(15.5px, 1.4vw, 18px); }
  .hero__more { display: inline-block; margin-top: 24px; color: #fff; letter-spacing: .1em; border-bottom: 1px solid rgba(255,255,255,.45); padding-bottom: 4px; }
  .hero__more:hover { border-bottom-color: var(--sky); color: var(--sky); }

  /* offerteformulier in de hero */
  .hform {
    background: var(--surface); border: 1px solid var(--line); border-top: 3px solid var(--blue);
    padding: clamp(20px, 2vw, 28px); display: grid; gap: 13px;
    box-shadow: 0 30px 70px -30px rgba(4, 26, 53, .55);
  }
  .hform__h { font-size: 19px; letter-spacing: .02em; }
  .hform label { display: grid; gap: 6px; font-family: var(--f-mono); font-size: 10.5px; letter-spacing: .07em; text-transform: uppercase; color: var(--steel); }
  .hform input, .hform textarea {
    font-family: var(--f-body); font-size: 15px; color: var(--ink); background: var(--surface);
    border: 1px solid var(--line); padding: 10px 12px; width: 100%;
  }
  .hform input:focus, .hform textarea:focus { outline: 2px solid var(--blue); outline-offset: 1px; border-color: var(--blue); }
  .hform textarea { resize: vertical; }
  .hform__row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .hform__btn { justify-content: center; }
  .hform__hint { color: var(--steel); font-size: 10px; letter-spacing: .05em; line-height: 1.8; text-transform: none; }
  .hform__hint a { color: var(--blue); text-decoration: underline; text-underline-offset: 2px; }
  .hero__meta {
    position: relative; z-index: 2; display: flex; flex-wrap: wrap; gap: 10px 0;
    margin-top: clamp(40px, 7vw, 90px); padding: 16px 0 18px;
    border-top: 1px solid rgba(255,255,255,.22); color: #B9CEE1;
  }
  .hero__meta span { letter-spacing: .1em; }
  .hero__meta span:not(:last-child)::after { content: "·"; margin-inline: 14px; color: var(--sky); }
  @media (max-width: 940px) {
    .hero__inner { grid-template-columns: 1fr; align-items: start; }
    .hform { max-width: 520px; }
  }
  @media (max-width: 700px) {
    .hero__media { position: relative; aspect-ratio: 4/3; }
    .hero__media :global(.ii) { position: absolute; inset: 0; width: 100%; aspect-ratio: auto !important; }
    .hero__scrim { background: linear-gradient(rgba(4,26,53,.15), rgba(4,26,53,.96)); }
    .hero__inner { margin-top: -64px; padding-top: 0; }
    .hform { max-width: none; }
  }

  /* ── intro ────────────────────────────────────────────── */
  .intro__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(28px, 4.5vw, 72px); align-items: center; }
  .intro__h { font-size: clamp(26px, 3vw, 40px); border-top: 1px solid var(--ink); padding-top: 16px; }
  .intro__text .prose { margin-top: 20px; }
  .facts { list-style: none; display: flex; flex-wrap: wrap; gap: 8px 34px; margin: 26px 0 0; padding: 14px 0 0; border-top: 1px solid var(--line); }
  .facts li { color: var(--steel); letter-spacing: .08em; }
  .facts b { color: var(--ink); font-family: var(--f-disp); font-size: 19px; font-weight: 600; margin-right: 7px; }
  .intro__pand { margin: 0; }
  .intro__pand figcaption { margin-top: 10px; color: var(--steel); font-family: var(--f-mono); font-size: 10.5px; letter-spacing: .1em; text-transform: uppercase; }
  @media (max-width: 780px) { .intro__grid { grid-template-columns: 1fr; } }

  /* ── mogelijkheden — compacte fotomozaïek ─────────────── */
  .mosaic {
    display: grid; grid-template-columns: repeat(12, 1fr);
    grid-auto-rows: clamp(240px, 28vw, 420px); gap: clamp(12px, 1.4vw, 20px);
  }
  .tile--0 { grid-column: span 7; }
  .tile--1 { grid-column: span 5; }
  .tile--2 { grid-column: span 5; }
  .tile--3 { grid-column: span 7; }

  .tile { position: relative; overflow: hidden; display: block; background: var(--navy); }
  .tile :global(.ii) { position: absolute; inset: 0; height: 100%; aspect-ratio: auto !important; border: 0; }
  .tile :global(.ii img) { height: 100%; }
  .tile__scrim {
    position: absolute; inset: 0; z-index: 2;
    background: linear-gradient(rgba(4,26,53,.06) 40%, rgba(4,26,53,.82) 100%);
    transition: background .3s var(--ease);
  }
  .tile__idx {
    position: absolute; top: 14px; right: 16px; z-index: 3;
    color: rgba(255,255,255,.85); font-size: 13px; letter-spacing: .12em;
    border-bottom: 1px solid var(--sky); padding-bottom: 4px;
  }
  .tile__body { position: absolute; inset: auto 0 0 0; z-index: 3; padding: clamp(16px, 2vw, 26px); }
  .tile__body h3 { color: #fff; font-size: clamp(21px, 2.2vw, 32px); }
  .tile__body p {
    color: #C9DAEA; font-size: 14px; margin-top: 8px; max-width: 36em;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .tile__go {
    display: inline-block; margin-top: 12px; color: var(--sky); font-size: 11px; letter-spacing: .1em;
  }
  .tile__go .arr { display: inline-block; transition: transform .25s var(--ease); }
  .tile:hover .tile__go .arr { transform: translateX(6px); }
  .tile:hover .tile__scrim { background: linear-gradient(rgba(4,26,53,.02) 40%, rgba(4,26,53,.9) 100%); }
  .tile :global(.ii__anno) { z-index: 3; }

  @media (max-width: 860px) {
    .mosaic { grid-auto-rows: clamp(220px, 42vw, 320px); }
    .tile--0, .tile--1, .tile--2, .tile--3 { grid-column: 1 / -1; }
    .tile__body p { display: none; }
  }

  /* scroll-effect: tegels rijzen op en beelden zoomen zacht uit tijdens het
     scrollen (CSS scroll-driven animations — werkt zonder JS, valt stil terug
     in browsers zonder ondersteuning en bij reduced motion). */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .tile {
        animation: tile-in linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 70%;
      }
      .tile :global(.ii img) {
        animation: tile-zoom linear both;
        animation-timeline: view();
        animation-range: entry 0% exit 100%;
      }
    }
  }
  @keyframes tile-in {
    from { opacity: .3; transform: translateY(34px); }
    to { opacity: 1; transform: none; }
  }
  @keyframes tile-zoom {
    from { transform: scale(1.12); }
    to { transform: scale(1); }
  }

  /* ── productie in beeld ───────────────────────────────── */
  .proof { padding-bottom: clamp(48px, 7vw, 96px); }
  .proof__wide { position: relative; margin: 0; }
  .proof__wide :global(.ii) { border-inline: 0; }
  .proof__quote {
    position: absolute; inset: auto 0 0 0; z-index: 2; padding-bottom: clamp(18px, 3vw, 40px);
  }
  .proof__quote p {
    color: #fff; font-family: var(--f-disp); font-weight: 600; text-transform: uppercase;
    font-size: clamp(18px, 2.6vw, 34px); line-height: 1.15; letter-spacing: .01em;
    text-shadow: 0 1px 24px rgba(4, 26, 53, .55); max-width: 24em;
  }
  .proof__wide::after {
    content: ""; position: absolute; inset: 0;
    background: linear-gradient(rgba(4,26,53,0) 45%, rgba(4,26,53,.62) 100%);
  }
  .proof__quote { z-index: 3; }
  .proof__row {
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(14px, 2vw, 24px); margin-top: clamp(16px, 2.4vw, 28px);
  }
  .proof__row figure { margin: 0; }
  .proof__row figcaption { margin-top: 9px; color: var(--steel); font-size: 10.5px; letter-spacing: .1em; }
  .proof__link { display: flex; flex-direction: column; justify-content: flex-end; gap: 14px; border-left: 1px solid var(--line); padding-left: clamp(14px, 2vw, 24px); }
  .proof__link p { color: var(--ink-2); font-size: 15px; }
  @media (max-width: 780px) {
    .proof__row { grid-template-columns: 1fr 1fr; }
    .proof__link { border-left: 0; padding-left: 0; }
  }

  /* ── mensen ───────────────────────────────────────────── */
  .people { background: var(--surface-2); }
  .people__grid { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(24px, 4.5vw, 72px); align-items: center; }
  .people__photo { margin: 0; max-width: 460px; }
  .people__text h2 { font-size: clamp(30px, 3.8vw, 52px); margin-top: 14px; }
  .people__text .prose { margin-top: 18px; }
  .people__certs { margin-top: 22px; color: var(--steel); letter-spacing: .08em; line-height: 2; }
  .people__acts { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 24px; }
  @media (max-width: 780px) {
    .people__grid { grid-template-columns: 1fr; }
    .people__photo { max-width: none; }
  }
</style>
