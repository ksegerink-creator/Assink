---
import { getCollection } from "astro:content";
import { createReader } from "@keystatic/core/reader";
import keystaticConfig from "../../keystatic.config";
import PageLayout from "@layouts/PageLayout.astro";
import SectionHead from "@components/sections/SectionHead.astro";
import IndustrialImage from "@components/media/IndustrialImage.astro";
import CtaBand from "@components/sections/CtaBand.astro";
import { photo } from "@utils/photos";

const reader = createReader(process.cwd(), keystaticConfig);
const q = await reader.singletons.kwaliteit.read();
if (!q) throw new Error("Kwaliteit-content ontbreekt (src/content/pages/kwaliteit).");

const certs = (await getCollection("certifications")).sort((a, b) => a.data.order - b.data.order);
---
<PageLayout
  title="Kwaliteit & certificering"
  description="ISO 9001, ISO 3834-2 en ISO 1090-1 gecertificeerd. Beheerste lasprocessen, maatcontrole en documentatie — Assink & Schipholt, Hengelo."
  canonicalSlug="kwaliteit"
  trail={[{ label: "Kwaliteit", slug: "kwaliteit" }]}
>
  <section class="sec ov-hero">
    <div class="wrap grid2">
      <div class="rv">
        <span class="eyebrow mono"><b>{q.kicker}</b></span>
        <h1>{q.titel}</h1>
        <p class="lead">{q.lead}</p>
      </div>
      <div class="rv">
        <IndustrialImage
          src={photo(q.heroFoto)}
          alt="Kwaliteitscontrole van een RVS-onderdeel"
          ratio="16/10"
          annotation="Maatcontrole"
          number="QA-00"
        />
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <SectionHead title="Certificeringen" index="Aantoonbaar" />
      <div class="g-3 rv">
        {certs.map((c) => (
          <article class="card">
            <span class="idx">◆ Certificering</span>
            <h3>{c.data.name}</h3>
            <p>{c.data.scope}</p>
            {c.data.document && (
              <a class="go" href={`/documents/${c.data.document}`}>Certificaat (PDF) →</a>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="sec tight">
    <div class="wrap">
      <SectionHead title="Kwaliteitsproces" index="Van ingang tot vrijgave" />
      <ul class="rows">
        {q.proces.map((p, i) => (
          <li class="row rv">
            <span class="idx">{String(i + 1).padStart(2, "0")}</span>
            <h3>{p.stap}</h3>
            <p>{p.tekst}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand />
</PageLayout>

<style>
  .ov-hero { padding-block: clamp(30px, 4vw, 52px) clamp(40px, 6vw, 72px); }
  .ov-hero .grid2 { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr); gap: clamp(28px, 4vw, 56px); align-items: center; }
  .ov-hero h1 { font-size: clamp(38px, 5.4vw, 74px); }
  .ov-hero .lead { max-width: 34em; color: var(--ink-2); font-size: clamp(16px, 1.4vw, 19px); margin-top: 20px; }
  @media (max-width: 820px) { .ov-hero .grid2 { grid-template-columns: 1fr; } }
</style>
