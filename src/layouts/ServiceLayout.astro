---
import PageLayout from "./PageLayout.astro";
import IndustrialImage from "@components/media/IndustrialImage.astro";
import SplitHero from "@components/sections/SplitHero.astro";
import CtaBand from "@components/sections/CtaBand.astro";
import FaqBlock from "@components/sections/FaqBlock.astro";
import { t } from "@data/i18n";
import { serviceJsonLd, faqJsonLd } from "@utils/seo";
import { toLocale, localizePath } from "@utils/paths";
import { serviceImageFor, serviceMidImageFor } from "@data/images";
import { photo } from "@utils/photos";
import { SITE } from "@data/site";
import type { CollectionEntry } from "astro:content";

interface Props { service: CollectionEntry<"services">["data"] }
const { service: s } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const site = Astro.site ?? new URL(SITE.url);
const nav = (slug: string) => localizePath(slug, locale);

const heroImg = photo(s.foto) ?? serviceImageFor(s.slug);
const midImg = serviceMidImageFor(s.group);
// Toon het middenbeeld alleen als het niet hetzelfde beeld is als de hero.
const showMid = midImg && midImg !== heroImg && s.process.length > 0;

const parts = s.slug.split("/");
const trail =
  parts.length > 1 && parts[0] === "plaatwerk"
    ? [{ label: t(locale, "plaatwerkTrail"), slug: "plaatwerk" }, { label: s.title, slug: s.slug }]
    : [{ label: s.title, slug: s.slug }];

const jsonld = [serviceJsonLd(site, { name: s.title, description: s.intro, slug: s.slug, locale })];

// FAQPage naast het Service-schema. De vragen staan zichtbaar op de pagina, wat
// een voorwaarde is: structured data mag alleen beschrijven wat de bezoeker ook
// ziet.
if (s.faq.length > 0) jsonld.push(faqJsonLd(s.faq) as never);
---
<PageLayout
  title={s.seo?.title || s.title}
  description={s.seo?.description || s.intro}
  canonicalSlug={s.slug}
  altLocales={["nl", "en", "de"]}
  ogPhoto={heroImg}
  trail={trail}
  jsonld={jsonld}
>
  <SplitHero kicker={s.kicker} title={s.h1} lead={s.intro} image={heroImg} alt={s.heroPhoto.subject}>
    <div class="shero__acts">
      <a class="btn" href={nav("offerte")}>{t(locale, "quote")}</a>
      <a class="btn ghost" href={nav("contact")}>{t(locale, "talk")}</a>
    </div>
  </SplitHero>

  {s.body.length > 0 && (
    <section class="sec tight">
      <div class="wrap sbody">
        <h2 class="sbody__h rv">{s.bodyHeading || t(locale, "aboutOperation")}</h2>
        <div class="prose rv">
          {s.body.map((p) => <p set:html={p} />)}
          {s.materials.length > 0 && (
            <p class="smat mono">{t(locale, "materialsLabel")}: <b>{s.materials.join(" · ")}</b></p>
          )}
        </div>
      </div>
    </section>
  )}

  {s.process.length > 0 && (
    <section class="sec tight">
      <div class="wrap sproc">
        <div class="sproc__side rv">
          <h2>{t(locale, "drawingToDelivery").split("|")[0]}<br />{t(locale, "drawingToDelivery").split("|")[1]}</h2>
          {showMid && (
            <figure class="sproc__img">
              <IndustrialImage src={midImg} alt={`${s.title} — productie in de werkplaats`} ratio="4/5" />
            </figure>
          )}
        </div>
        <ol class="sproc__list">
          {s.process.map((p, i) => (
            <li class="rv">
              <span class="mono">{String(i + 1).padStart(2, "0")}</span>
              <div>
                <h3>{p.step}</h3>
                <p>{p.desc}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  {s.specs.length > 0 && (
    <section class="sec tight">
      <div class="wrap sspec">
        <h2 class="rv">{t(locale, "specsHead")}</h2>
        <div class="tbl-wrap rv">
          <table class="tbl">
            <caption>{t(locale, "specsCaption")}</caption>
            <tbody>
              {s.specs.map((r) => (
                <tr><th scope="row">{r.label}</th><td class="spec">{r.value}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  )}

  {s.applications.length > 0 && (
    <section class="sec tight">
      <div class="wrap sapp rv">
        <h2>{t(locale, "applicationsHead")}</h2>
        <p>{s.applications.join(" · ")}</p>
      </div>
    </section>
  )}

  <FaqBlock faq={s.faq} />

  {s.related.length > 0 && (
    <section class="sec tight">
      <div class="wrap srel">
        <h2 class="rv">{t(locale, "related")}</h2>
        <ul class="srel__list rv">
          {s.related.map((r) => (
            <li>
              <a href={nav(r.slug)}>
                <span class="srel__label">{r.label}</span>
                {r.desc && <span class="srel__desc">{r.desc}</span>}
                <span class="mono srel__arr">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <CtaBand />
</PageLayout>

<style>
  .shero__acts { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 4px; }


  /* body */
  .sbody { display: grid; grid-template-columns: minmax(0, .55fr) minmax(0, 1.45fr); gap: clamp(20px, 3vw, 48px); }
  .sbody__h { font-size: clamp(22px, 2.4vw, 32px); border-top: 1px solid var(--ink); padding-top: 14px; }
  .smat { margin-top: 8px; color: var(--steel); }
  .smat b { color: var(--ink); font-weight: 600; }
  @media (max-width: 780px) { .sbody { grid-template-columns: 1fr; } }

  /* proces */
  .sproc { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(24px, 4vw, 64px); align-items: start; }
  .sproc__side h2 { font-size: clamp(24px, 2.8vw, 38px); border-top: 1px solid var(--ink); padding-top: 14px; }
  .sproc__img { margin: 22px 0 0; max-width: 380px; }
  .sproc__list { list-style: none; margin: 0; padding: 0; }
  .sproc__list li {
    display: grid; grid-template-columns: 52px 1fr; gap: 16px; align-items: baseline;
    padding-block: 18px; border-bottom: 1px solid var(--line);
  }
  .sproc__list li:first-child { padding-top: 4px; }
  .sproc__list .mono { color: var(--blue); }
  .sproc__list h3 { font-size: clamp(17px, 1.8vw, 22px); }
  .sproc__list p { color: var(--ink-2); font-size: 15px; margin-top: 6px; max-width: 44em; }
  @media (max-width: 780px) { .sproc { grid-template-columns: 1fr; } .sproc__img { display: none; } }

  /* specificaties / toepassingen / gerelateerd */
  .sspec h2, .sapp h2, .srel h2 { font-size: clamp(20px, 2.2vw, 28px); margin-bottom: 18px; }
  .sspec .tbl { max-width: 720px; }
  .sapp p { color: var(--ink-2); max-width: 52em; font-size: 16px; line-height: 1.9; }
  .srel__list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); max-width: 760px; }
  .srel__list li { border-bottom: 1px solid var(--line); }
  .srel__list a { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr) auto; gap: 16px; align-items: baseline; padding: 15px 2px; }
  .srel__label { font-family: var(--f-disp); font-weight: 600; text-transform: uppercase; letter-spacing: .03em; font-size: 16px; color: var(--ink); }
  .srel__desc { color: var(--steel); font-size: 14px; }
  .srel__arr { color: var(--blue); }
  .srel__list a:hover .srel__label { color: var(--blue); }
  @media (max-width: 640px) { .srel__list a { grid-template-columns: 1fr auto; } .srel__desc { display: none; } }
</style>
