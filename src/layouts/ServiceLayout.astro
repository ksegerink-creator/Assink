---
import PageLayout from "./PageLayout.astro";
import SplitHero from "@components/sections/SplitHero.astro";
import Kerncijfers from "@components/sections/Kerncijfers.astro";
import Kenmerken from "@components/sections/Kenmerken.astro";
import ProcessSteps from "@components/sections/ProcessSteps.astro";
import SpecTable from "@components/sections/SpecTable.astro";
import Aanleverlijst from "@components/sections/Aanleverlijst.astro";
import CtaBand from "@components/sections/CtaBand.astro";
import FaqBlock from "@components/sections/FaqBlock.astro";
import Kennisbanklinks from "@components/sections/Kennisbanklinks.astro";
import BodyText from "@components/sections/BodyText.astro";
import { t } from "@data/i18n";
import { serviceJsonLd, faqJsonLd } from "@utils/seo";
import { toLocale, localizePath } from "@utils/paths";
import { serviceImageFor } from "@data/images";
import { kiesFoto } from "@utils/fotobank";
import { kickerVoor } from "@utils/menu";
import { SITE } from "@data/site";
import type { CollectionEntry } from "astro:content";

interface Props { service: CollectionEntry<"services">["data"] }
const { service: s } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const site = Astro.site ?? new URL(SITE.url);
const nav = (slug: string) => localizePath(slug, locale);

// Zonder eigen kicker: de menukolom en het nummer waar deze pagina staat.
const kicker = await kickerVoor(s.slug, locale, s.kicker);
// Eigen upload gaat voor, dan de keuze uit de fotobank, dan het standaardbeeld.
const heroImg = await kiesFoto(s.foto, s.fotobank, serviceImageFor(s.slug));
// Eigen foto uit het CMS gaat voor; zonder upload valt de pagina terug op
// het standaardbeeld van haar groep in src/data/images.ts.
/*
 * De foto halverwege de pagina komt alleen uit het CMS-veld van de pagina zelf.
 * Eerder stond er een vaste foto per groep, waardoor zes sectorpagina's
 * hetzelfde beeld toonden — elk met een andere alt-tekst, dus hoogstens één
 * ervan kon kloppen. Staat er geen foto, dan blijft de sectie zonder beeld.
 */
const midImg = await kiesFoto(s.midFoto, s.midFotoBank);
// Toon het middenbeeld alleen als het niet hetzelfde beeld is als de hero.
const showMid = midImg && midImg !== heroImg && s.process.length > 0;

const parts = s.slug.split("/");
const trail =
  parts.length > 1 && parts[0] === "plaatwerk"
    ? [{ label: t(locale, "plaatwerkTrail"), slug: "plaatwerk" }, { label: s.title, slug: s.slug }]
    : [{ label: s.title, slug: s.slug }];

const jsonld = [serviceJsonLd(site, { name: s.title, description: s.intro, slug: s.slug, locale })];

// FAQPage naast het Service-schema. De vragen staan zichtbaar op de pagina, wat
// een voorwaarde is: structured data mag alleen beschrijven wat de bezoeker ook
// ziet.
if (s.faq.length > 0) jsonld.push(faqJsonLd(s.faq) as never);
---
<PageLayout
  title={s.seo?.title || s.title}
  description={s.seo?.description || s.intro}
  canonicalSlug={s.slug}
  altLocales={["nl", "en", "de"]}
  ogPhoto={heroImg}
  trail={trail}
  jsonld={jsonld}
>
  <SplitHero kicker={kicker} title={s.h1} lead={s.intro} image={heroImg} alt={s.heroPhoto.subject}>
    <div class="shero__acts">
      <a class="btn" href={nav("offerte")}>{t(locale, "quote")}</a>
      <a class="btn ghost" href={nav("contact")}>{t(locale, "talk")}</a>
    </div>
  </SplitHero>

  <Kenmerken items={s.kenmerken} />
  <Kerncijfers items={s.kerncijfers} />

  <BodyText
    body={s.body}
    locale={locale}
    kop={s.bodyHeading || t(locale, s.group === "sector" ? "aboutSector" : "aboutOperation")}
    materials={s.materials}
    toepassingen={s.applications}
  />

  <ProcessSteps process={s.process} locale={locale} image={showMid ? midImg : undefined}
    imageAlt={`${s.title} — productie in de werkplaats`} />

  <SpecTable specs={s.specs} locale={locale} />

  <Aanleverlijst items={s.aanleveren} locale={locale} />

  <FaqBlock faq={s.faq} />

  <Kennisbanklinks slug={s.slug} />

  {s.related.length > 0 && (
    <section class="sec tight">
      <div class="wrap srel">
        <h2 class="rv">{t(locale, "related")}</h2>
        <ul class="srel__list rv">
          {s.related.map((r) => (
            <li>
              <a href={nav(r.slug)}>
                <span class="srel__label">{r.label}</span>
                {r.desc && <span class="srel__desc">{r.desc}</span>}
                <span class="mono srel__arr">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <CtaBand />
</PageLayout>

<style>
  .shero__acts { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 4px; }


  /* toepassingen / gerelateerd */
  .srel h2 { font-size: clamp(20px, 2.2vw, 28px); margin-bottom: 18px; }
  /* Gerelateerd als kaarten: een duidelijke volgende stap in plaats van een
     dunne lijst onderaan. */
  .srel__list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 14px; }
  .srel__list a {
    display: grid; grid-template-rows: auto 1fr auto; gap: 6px; height: 100%;
    border: 1px solid var(--line); background: var(--surface); padding: 18px 20px;
    transition: border-color .2s var(--ease), background .2s var(--ease);
  }
  .srel__list a:hover { border-color: var(--blue); background: var(--sky-bg); }
  .srel__label { font-family: var(--f-disp); font-weight: 600; text-transform: uppercase; letter-spacing: .03em; font-size: 17px; color: var(--ink); }
  .srel__desc { color: var(--ink-2); font-size: 14.5px; }
  .srel__arr { color: var(--blue); margin-top: 6px; }
  .srel__list a:hover .srel__label { color: var(--blue); }
</style>
