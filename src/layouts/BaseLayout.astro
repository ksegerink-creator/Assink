---
import "@styles/global.css";
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { SITE } from "@data/site";
import { HTML_LANG } from "@data/i18n";
import { hreflangAlternates, absUrl, toLocale } from "@utils/paths";
import { organizationJsonLd } from "@utils/seo";
import type { Locale } from "@data/site";

interface Props {
  title: string;
  description: string;
  /** Canonical Dutch slug for this page (without slashes), "" for home. */
  canonicalSlug: string;
  /** Locales in which this page exists (for hreflang). Defaults to NL only. */
  altLocales?: Locale[];
  /** Pad naar een vaste afbeelding in /public (terugval: het logo). */
  image?: string;
  /**
   * Echte paginafoto voor het deelvoorbeeld op LinkedIn/Facebook/WhatsApp.
   * Wordt automatisch naar 1200×630 JPEG omgezet; heeft voorrang op `image`.
   */
  ogPhoto?: ImageMetadata;
  noindex?: boolean;
  /** Extra JSON-LD graphs to embed (breadcrumb, service, jobposting…). */
  jsonld?: unknown[];
  /** og:type — "article" voor kennisbankartikelen, anders "website". */
  ogType?: "website" | "article";
}

const {
  title,
  description,
  canonicalSlug,
  altLocales = ["nl"],
  image = "/logos/og-default.png",
  ogPhoto,
  noindex: noindexProp = false,
  jsonld = [],
  ogType = "website",
} = Astro.props;

// Tot livegang staat de site als preview op *.vercel.app; die mag niet
// geïndexeerd worden. Indexeren pas toestaan als PUBLIC_SITE_LIVE="true" is
// gezet (Vercel-omgevingsvariabele, in te stellen bij livegang op het echte domein).
const siteLive = import.meta.env.PUBLIC_SITE_LIVE === "true";
const noindex = noindexProp || !siteLive;

// Analytics alleen op de live productiesite — nooit op previews/dev, zodat
// testbezoeken de statistieken niet vervuilen. Het meet-ID gaat letterlijk in
// een inline <script>, dus we accepteren alleen de vorm die Google uitgeeft
// (G-, daarna letters en cijfers). Een typefout of een geplakte URL in de
// omgevingsvariabele levert dan geen kapotte pagina op, maar simpelweg geen tag.
const GA_ID_PATTERN = /^G-[A-Z0-9]+$/;
const gaIdRaw = siteLive ? import.meta.env.PUBLIC_GA_ID : undefined;
const gaId = gaIdRaw && GA_ID_PATTERN.test(gaIdRaw) ? gaIdRaw : undefined;
if (gaIdRaw && !gaId) {
  console.warn(`PUBLIC_GA_ID "${gaIdRaw}" heeft niet de vorm G-XXXXXXXXXX; analytics wordt overgeslagen.`);
}

const locale: Locale = toLocale(Astro.currentLocale);
const site = Astro.site ?? new URL(SITE.url);
const canonical = absUrl(site, canonicalSlug, locale);
const alternates = altLocales.length > 1 ? hreflangAlternates(site, canonicalSlug, altLocales) : [];
/**
 * Deelafbeelding. Is er een paginafoto meegegeven, dan maken we daar een
 * 1200×630 JPEG van — het formaat dat LinkedIn, Facebook en WhatsApp
 * verwachten. Bewust JPEG en niet WebP: die laatste wordt door die platforms
 * niet betrouwbaar weergegeven, terwijl WebP op de site zelf wél wordt gebruikt.
 * Zonder foto valt het terug op het standaardlogo.
 */
const OG_W = 1200;
const OG_H = 630;
const ogSrc = ogPhoto
  ? (await getImage({ src: ogPhoto, width: OG_W, height: OG_H, format: "jpeg", fit: "cover" })).src
  : image;
const ogImage = new URL(ogSrc, site).href;
const graphs = [organizationJsonLd(site), ...jsonld];
---

<!doctype html>
<html lang={HTML_LANG[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={HTML_LANG[locale].replace("-", "_")} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(OG_W)} />
    <meta property="og:image:height" content={String(OG_H)} />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#0C1F3A" />
    <meta name="generator" content={Astro.generator} />

    {/*
      set:html zet de JSON onbewerkt in de pagina en JSON.stringify ontsnapt "<"
      niet. Een CMS-veld met "</script>" erin sluit daardoor deze tag af en alles
      erna wordt als script uitgevoerd. Titels, omschrijvingen, breadcrumb-labels
      en FAQ-antwoorden komen hier rechtstreeks in terecht — ook de tekst die de
      blogconceptgenerator automatisch schrijft. "\u003c" is geldige JSON en
      levert dezelfde structured data op.
    */}
    {graphs.map((g) => (
      <script type="application/ld+json" set:html={JSON.stringify(g).replace(/</g, "\\u003c")} />
    ))}

    {gaId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        {/*
          Bewust is:inline met set:html en niet define:vars: die laatste wikkelt
          de code in een IIFE, waardoor "gtag" een lokale functie wordt en
          window.gtag ongedefinieerd blijft. De pageview vertrekt dan nog wel
          (gtag.js leest window.dataLayer), maar elke latere gtag()-aanroep —
          een custom event, een consent-update — faalt. Zo staat de functie op
          de global scope, precies zoals het standaardsnippet van Google.
        */}
        <script is:inline set:html={`window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag("js", new Date());
gtag("config", "${gaId}");`} />
      </>
    )}

    <!-- Progressive enhancement flag for reveal animations. -->
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body>
    <slot />

    <script>
      // Reveal-on-scroll — the only client-side JS on content pages.
      const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
      const els = Array.from(document.querySelectorAll<HTMLElement>(".rv"));
      if (reduce || !("IntersectionObserver" in window)) {
        els.forEach((el) => el.classList.add("in"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add("in");
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: "0px 0px -6% 0px" },
        );
        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
